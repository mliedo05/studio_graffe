<% content_for :page_title, "Dashboard" %>
<!-- Resumen mensual acumulado -->
<div class="sv-table-wrap" style="margin-bottom:28px;">
  <div class="sv-table-head">
    <h3>📅 Resumen mensual acumulado (últimos 12 meses)</h3>
  </div>
  <table class="sv-table">
    <thead>
      <tr>
        <th>Mes</th>
        <th style="text-align:right;">Total (c/IVA)</th>
        <th style="text-align:right;">IVA (19%)</th>
        <th style="text-align:right;">Neto (s/IVA)</th>
        <th style="text-align:right; color:#C9A96E;">Monto estilistas</th>
        <th style="text-align:right; color:#1A1A1A;">Monto estudio</th>
      </tr>
    </thead>
    <tbody>
      <% if @monthly_summary.any? %>
        <% @monthly_summary.each do |m| %>
          <tr>
            <td style="font-weight:600; text-transform:capitalize;"><%= m[:month] %></td>
            <td style="text-align:right; font-weight:600;"><%= number_to_currency(m[:total],   unit: "$", delimiter: ".", precision: 0) %></td>
            <td style="text-align:right; color:#6b7280;"><%= number_to_currency(m[:iva],     unit: "$", delimiter: ".", precision: 0) %></td>
            <td style="text-align:right;"><%= number_to_currency(m[:net],     unit: "$", delimiter: ".", precision: 0) %></td>
            <td style="text-align:right; color:#C9A96E; font-weight:600;"><%= number_to_currency(m[:stylist], unit: "$", delimiter: ".", precision: 0) %></td>
            <td style="text-align:right; font-weight:600;"><%= number_to_currency(m[:studio],  unit: "$", delimiter: ".", precision: 0) %></td>
          </tr>
        <% end %>
        <%# Fila de totales %>
        <% totals = @monthly_summary.each_with_object(Hash.new(0)) { |m, h| m.except(:month).each { |k, v| h[k] += v } } %>
        <tr style="background:#f9fafb; font-weight:700; border-top:2px solid #e5e7eb;">
          <td>TOTAL</td>
          <td style="text-align:right;"><%= number_to_currency(totals[:total],   unit: "$", delimiter: ".", precision: 0) %></td>
          <td style="text-align:right; color:#6b7280;"><%= number_to_currency(totals[:iva],     unit: "$", delimiter: ".", precision: 0) %></td>
          <td style="text-align:right;"><%= number_to_currency(totals[:net],     unit: "$", delimiter: ".", precision: 0) %></td>
          <td style="text-align:right; color:#C9A96E;"><%= number_to_currency(totals[:stylist], unit: "$", delimiter: ".", precision: 0) %></td>
          <td style="text-align:right;"><%= number_to_currency(totals[:studio],  unit: "$", delimiter: ".", precision: 0) %></td>
        </tr>
      <% else %>
        <tr><td colspan="6" style="text-align:center; color:#9ca3af; padding:24px;">Sin registros</td></tr>
      <% end %>
    </tbody>
  </table>
</div>

<!-- Selector de período -->
<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px;">
  <h1 style="font-size:20px; font-weight:700;">Resumen del período</h1>
  <div class="period-tabs">
    <%= link_to "Hoy",    supervisor_root_path(period: "today"),  class: "period-tab #{current_period == "today"  ? "active" : ""}" %>
    <%= link_to "Semana", supervisor_root_path(period: "week"),   class: "period-tab #{current_period == "week"   ? "active" : ""}" %>
    <%= link_to "Mes",    supervisor_root_path(period: "month"),  class: "period-tab #{current_period == "month"  ? "active" : ""}" %>
    <%= link_to "Rango",  supervisor_root_path(period: "custom"), class: "period-tab #{current_period == "custom" ? "active" : ""}" %>
  </div>
</div>

<% if current_period == "custom" %>
  <div style="background:#fff; border:1px solid #e5e7eb; border-radius:8px; padding:16px 20px; margin-bottom:24px; display:flex; gap:16px; align-items:flex-end;">
    <div>
      <label style="font-size:11px; font-weight:600; color:#9ca3af; display:block; margin-bottom:4px;">Desde</label>
      <input type="date" id="from-date" value="<%= params[:from] %>" style="padding:8px 10px; border:1px solid #d1d5db; border-radius:6px; font-size:13px;">
    </div>
    <div>
      <label style="font-size:11px; font-weight:600; color:#9ca3af; display:block; margin-bottom:4px;">Hasta</label>
      <input type="date" id="to-date" value="<%= params[:to] %>" style="padding:8px 10px; border:1px solid #d1d5db; border-radius:6px; font-size:13px;">
    </div>
    <button onclick="applyCustomRange()" class="btn btn-gold btn-sm">Aplicar</button>
  </div>
  <script>
    function applyCustomRange() {
      var from = document.getElementById('from-date').value;
      var to   = document.getElementById('to-date').value;
      window.location.href = '<%= supervisor_root_path(period: "custom") %>&from=' + from + '&to=' + to;
    }
  </script>
<% end %>



<!-- KPI Cards -->
<div class="sv-cards">
  <div class="sv-card">
    <div class="sv-card-label">💰 Ventas totales</div>
    <div class="sv-card-value" style="color:#16a34a;">
      <%= number_to_currency(@total_sales_cents , unit: "$", delimiter: ".", precision: 0) %>
    </div>
    <div class="sv-card-sub"><%= @attendances_count %> atenciones</div>
  </div>
  <div class="sv-card">
    <div class="sv-card-label">💸 Total comisiones</div>
    <div class="sv-card-value" style="color:#C9A96E;">
      <%= number_to_currency(@total_commissions_cents , unit: "$", delimiter: ".", precision: 0) %>
    </div>
    <div class="sv-card-sub">
      <% margin = @total_sales_cents > 0 ? ((@total_sales_cents - @total_commissions_cents) * 100.0 / @total_sales_cents).round(1) : 0 %>
      <%= margin %>% margen neto
    </div>
  </div>
  <div class="sv-card">
    <div class="sv-card-label">📋 Atenciones</div>
    <div class="sv-card-value"><%= @attendances_count %></div>
    <div class="sv-card-sub">registradas en el período</div>
  </div>
  <div class="sv-card">
    <div class="sv-card-label">⚠️ Stock crítico</div>
    <div class="sv-card-value" style="color:<%= @critical_stock.any? ? "#dc2626" : "#16a34a" %>;">
      <%= @critical_stock.count %>
    </div>
    <div class="sv-card-sub">productos con ≤ 3 unidades</div>
  </div>
</div>

<%# Helper local para mostrar placeholder cuando no hay datos %>
<% no_data_placeholder = '<div style="display:flex;align-items:center;justify-content:center;height:180px;color:#9ca3af;font-size:13px;">Sin registros para este período</div>' %>



<!-- Gráficos ventas + comisiones -->
<div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:28px;">
  <div class="chart-wrap">
    <h3>Ventas por día</h3>
    <% if @sales_by_day.any? %>
      <canvas id="salesChart" height="200"></canvas>
    <% else %>
      <%= no_data_placeholder.html_safe %>
    <% end %>
  </div>
  <div class="chart-wrap">
    <h3>Comisiones por estilista</h3>
    <% if @commissions_by_stylist.any? %>
      <canvas id="commissionChart" height="200"></canvas>
    <% else %>
      <%= no_data_placeholder.html_safe %>
    <% end %>
  </div>
</div>

<!-- Gráfico servicios: frecuencia + ingresos -->
<div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:28px;">
  <div class="chart-wrap">
    <h3>✂️ Servicios más realizados</h3>
    <% if @services_frequency.any? %>
      <canvas id="servicesFreqChart"></canvas>
    <% else %>
      <%= no_data_placeholder.html_safe %>
    <% end %>
  </div>
  <div class="chart-wrap">
    <h3>💰 Servicios que más ingresos generan</h3>
    <% if @services_revenue.any? %>
      <canvas id="servicesRevChart"></canvas>
    <% else %>
      <%= no_data_placeholder.html_safe %>
    <% end %>
  </div>
</div>

<!-- Últimas atenciones -->
<div class="sv-table-wrap">
  <div class="sv-table-head" style="display:flex; justify-content:space-between; align-items:center;">
    <h3>Últimas atenciones</h3>
    <%= link_to "Ver todas →", supervisor_attendances_path, class: "btn btn-outline btn-sm" %>
  </div>
  <table class="sv-table">
    <thead>
      <tr>
        <th>N°</th><th>Fecha</th><th>Cliente</th><th>Items</th><th>Total</th><th>Pagado</th><th>Estado</th><th></th>
      </tr>
    </thead>
    <tbody>
      <% @recent_attendances.each do |a| %>
        <tr>
          <td><code style="font-size:12px;"><%= a.number %></code></td>
          <td><%= a.attended_on.strftime("%d/%m/%Y") %></td>
          <td><%= a.display_client_name %></td>
          <td><%= a.attendance_items.size %></td>
          <td style="font-weight:600;"><%= number_to_currency(a.total_cents , unit: "$", delimiter: ".", precision: 0) %></td>
          <td><%= number_to_currency(a.paid_cents , unit: "$", delimiter: ".", precision: 0) %></td>
          <td>
            <span class="badge <%= a.status == "closed" ? "badge-green" : "badge-yellow" %>">
              <%= a.status == "closed" ? "Cerrada" : "Abierta" %>
            </span>
          </td>
          <td><%= link_to "Ver", supervisor_attendance_path(a), class: "btn btn-outline btn-sm" %></td>
        </tr>
      <% end %>
      <% if @recent_attendances.empty? %>
        <tr><td colspan="8" style="text-align:center; color:#9ca3af; padding:24px;">Sin atenciones en este período</td></tr>
      <% end %>
    </tbody>
  </table>
</div>

<script>
(function() { // IIFE: evita que const/let fallen al re-ejecutar con Turbo
function mkChart(id, config) {
  const prev = Chart.getChart(id);
  if (prev) prev.destroy();
  const el = document.getElementById(id);
  if (el) new Chart(el, config);
}

// Ventas por día
mkChart('salesChart', {
  type: 'bar',
  data: {
    labels: <%= raw @sales_by_day.keys.to_json %>,
    datasets: [{
      label: 'Ventas ($)',
      data: <%= raw @sales_by_day.values.map { |v| v  }.to_json %>,
      backgroundColor: 'rgba(201,169,110,0.7)',
      borderColor: '#C9A96E',
      borderWidth: 1, borderRadius: 4
    }]
  },
  options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { ticks: { callback: v => '$' + v.toLocaleString('es-CL') } } } }
});

// Comisiones por estilista
mkChart('commissionChart', {
  type: 'doughnut',
  data: {
    labels: <%= raw @commissions_by_stylist.keys.to_json %>,
    datasets: [{
      data: <%= raw @commissions_by_stylist.values.map { |v| v  }.to_json %>,
      backgroundColor: ['#C9A96E','#1A1A1A','#4f46e5','#16a34a','#dc2626','#d97706'],
    }]
  },
  options: { responsive: true, plugins: { legend: { position: 'right' } } }
});

<% if @services_frequency.any? %>
const PIE_COLORS = ['#C9A96E','#1A1A1A','#4f46e5','#16a34a','#dc2626','#d97706','#0891b2','#7c3aed','#be185d','#059669'];

mkChart('servicesFreqChart', {
  type: 'doughnut',
  data: {
    labels: <%= raw @services_frequency.keys.to_json %>,
    datasets: [{ data: <%= raw @services_frequency.values.to_json %>, backgroundColor: PIE_COLORS }]
  },
  options: {
    responsive: true,
    plugins: {
      legend: { position: 'right', labels: { boxWidth: 12, font: { size: 11 } } },
      tooltip: { callbacks: { label: ctx => ` ${ctx.label}: ${ctx.raw} ${ctx.raw === 1 ? 'vez' : 'veces'}` } }
    }
  }
});

mkChart('servicesRevChart', {
  type: 'doughnut',
  data: {
    labels: <%= raw @services_revenue.keys.to_json %>,
    datasets: [{ data: <%= raw @services_revenue.values.to_json %>, backgroundColor: PIE_COLORS }]
  },
  options: {
    responsive: true,
    plugins: {
      legend: { position: 'right', labels: { boxWidth: 12, font: { size: 11 } } },
      tooltip: { callbacks: { label: ctx => ` ${ctx.label}: $${ctx.raw.toLocaleString('es-CL')}` } }
    }
  }
});
<% end %>
})(); // fin IIFE
</script>
