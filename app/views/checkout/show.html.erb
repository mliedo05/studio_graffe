<% content_for :title, "Finalizar Compra — Studio Graffé" %>


<main class="pt-28 pb-20 px-4 sm:px-8 max-w-screen-lg mx-auto"
      data-controller="checkout">

  <%= form_with model: @order,
        url: checkout_payment_path,
        method: :post,
        local: true do |f| %>

    <!-- ══════════════════════════════════════════════════
         BARRA DE PASOS
    ══════════════════════════════════════════════════ -->
    <nav class="flex items-center justify-center mb-12 select-none">

      <% [
        { label: "Facturación",  icon: "receipt_long" },
        { label: "Envío",        icon: "local_shipping" },
        { label: "Confirmar",    icon: "check_circle" }
      ].each_with_index do |s, i| %>

        <%# Step bubble %>
        <button type="button"
                data-checkout-target="stepIndicator"
                data-state="<%= i == 0 ? 'active' : 'pending' %>"
                data-step="<%= i %>"
                data-action="click->checkout#goToStep"
                class="flex flex-col items-center gap-1.5 group">
          <span class="step-circle w-10 h-10 rounded-full flex items-center justify-center transition-all duration-200
                       bg-stone-100 text-stone-400
                       [[data-state=active]_&]:bg-stone-900 [[data-state=active]_&]:text-white [[data-state=active]_&]:ring-4 [[data-state=active]_&]:ring-stone-900/20
                       [[data-state=done]_&]:bg-stone-900 [[data-state=done]_&]:text-white">
            <span class="material-symbols-outlined text-[20px]"><%= s[:icon] %></span>
          </span>
          <span class="hidden sm:block text-xs transition-all duration-200
                       text-stone-400
                       [[data-state=active]_&]:text-stone-900 [[data-state=active]_&]:font-semibold
                       [[data-state=done]_&]:text-stone-900 [[data-state=done]_&]:font-medium">
            <%= s[:label] %>
          </span>
        </button>

        <% unless i == 2 %>
          <div class="step-line h-0.5 w-16 sm:w-24 bg-stone-200 mx-2 transition-colors duration-300
                      [[data-state=done]_~_&]:bg-stone-900"></div>
        <% end %>

      <% end %>
    </nav>


    <!-- ══════════════════════════════════════════════════
         PASO 1 — FACTURACIÓN
    ══════════════════════════════════════════════════ -->
    <div data-checkout-target="step">
      <div class="max-w-lg mx-auto">

        <!-- Banner de error — oculto hasta que falle la validación -->
        <div data-checkout-target="errorBanner"
             class="hidden mb-6 flex items-center gap-3 px-4 py-3 bg-red-50 border border-red-200 rounded-xl text-sm text-red-700">
          <span class="material-symbols-outlined text-red-400 shrink-0">error</span>
          <span>Por favor completa todos los campos obligatorios antes de continuar.</span>
        </div>

        <div class="mb-8">
          <h1 class="text-2xl font-bold">Datos de Facturación</h1>
          <p class="text-sm text-stone-500 mt-1">Esta información aparecerá en tu boleta.</p>
        </div>

        <div class="space-y-6">

          <div class="grid grid-cols-2 gap-5">
            <div class="border-b border-stone-300 focus-within:border-stone-900 transition-colors pb-1">
              <label class="block text-[10px] font-semibold tracking-widest uppercase text-stone-400 mb-1">Nombre</label>
              <%= f.text_field :billing_first_name,
                    required: true, autocomplete: "given-name",
                    placeholder: "Ej: María",
                    class: "w-full bg-transparent border-none p-0 focus:ring-0 text-base" %>
            </div>
            <div class="border-b border-stone-300 focus-within:border-stone-900 transition-colors pb-1">
              <label class="block text-[10px] font-semibold tracking-widest uppercase text-stone-400 mb-1">Apellido</label>
              <%= f.text_field :billing_last_name,
                    required: true, autocomplete: "family-name",
                    placeholder: "Ej: González",
                    class: "w-full bg-transparent border-none p-0 focus:ring-0 text-base" %>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-5">
            <div class="border-b border-stone-300 focus-within:border-stone-900 transition-colors pb-1">
              <label class="block text-[10px] font-semibold tracking-widest uppercase text-stone-400 mb-1">Tipo de documento</label>
              <%= f.select :billing_document_type,
                    [["RUT", "rut"], ["Pasaporte", "passport"], ["DNI", "dni"]],
                    { selected: @order.billing_document_type || "rut" },
                    required: true,
                    class: "w-full bg-transparent border-none p-0 focus:ring-0 text-base cursor-pointer",
                    data: { action: "change->checkout#documentTypeChanged" } %>
            </div>
            <div class="border-b border-stone-300 focus-within:border-stone-900 transition-colors pb-1">
              <label class="block text-[10px] font-semibold tracking-widest uppercase text-stone-400 mb-1">Número</label>
              <%= f.text_field :billing_document_number,
                    required: true,
                    placeholder: "Ej: 12.345.678-9",
                    class: "w-full bg-transparent border-none p-0 focus:ring-0 text-base",
                    data: { checkout_target: "documentNumber" } %>
            </div>
          </div>

          <div class="border-b border-stone-300 focus-within:border-stone-900 transition-colors pb-1">
            <label class="block text-[10px] font-semibold tracking-widest uppercase text-stone-400 mb-1">Correo electrónico</label>
            <%= f.email_field :billing_email,
                  required: true, autocomplete: "email",
                  placeholder: "tu@correo.com",
                  class: "w-full bg-transparent border-none p-0 focus:ring-0 text-base" %>
          </div>

          <%= render "checkout/phone_field",
                f: f, field: :billing_phone,
                label_text: "Teléfono",
                required: true,
                value: @order.billing_phone %>

        </div>

        <div class="mt-10">
          <button type="button"
                  data-action="click->checkout#next"
                  class="w-full bg-stone-900 text-white py-4 rounded-xl font-semibold
                         tracking-wide hover:bg-stone-700 active:scale-[0.98] transition-all">
            Continuar con Envío →
          </button>
        </div>

      </div>
    </div>


    <!-- ══════════════════════════════════════════════════
         PASO 2 — ENVÍO
    ══════════════════════════════════════════════════ -->
    <div data-checkout-target="step" class="hidden">
      <div class="max-w-lg mx-auto">

        <!-- Banner de error paso 2 -->
        <div data-checkout-target="errorBanner"
             class="hidden mb-6 flex items-center gap-3 px-4 py-3 bg-red-50 border border-red-200 rounded-xl text-sm text-red-700">
          <span class="material-symbols-outlined text-red-400 shrink-0">error</span>
          <span>Por favor completa la dirección de entrega antes de continuar.</span>
        </div>

        <div class="mb-8">
          <h1 class="text-2xl font-bold">Tipo de Envío</h1>
          <p class="text-sm text-stone-500 mt-1">¿Cómo quieres recibir tu pedido?</p>
        </div>

        <!-- Opciones pickup / delivery -->
        <div class="grid grid-cols-2 gap-4 mb-6">
          <label class="flex flex-col items-center gap-3 p-5 border-2 border-stone-200 rounded-2xl
                        cursor-pointer hover:border-stone-400 transition-colors text-center
                        has-[:checked]:border-stone-900 has-[:checked]:bg-stone-50">
            <%= f.radio_button :shipping_type, "pickup",
                  checked: (@order.shipping_type.blank? || @order.shipping_type == "pickup"),
                  class: "sr-only",
                  data: { action: "change->checkout#shippingTypeChanged" } %>
            <span class="material-symbols-outlined text-3xl text-stone-700">storefront</span>
            <p class="font-semibold text-sm">Retiro en tienda</p>
            <p class="text-xs text-stone-400">Gratis · 2–3 días hábiles</p>
          </label>

          <label class="flex flex-col items-center gap-3 p-5 border-2 border-stone-200 rounded-2xl
                        cursor-pointer hover:border-stone-400 transition-colors text-center
                        has-[:checked]:border-stone-900 has-[:checked]:bg-stone-50">
            <%= f.radio_button :shipping_type, "delivery",
                  checked: @order.shipping_type == "delivery",
                  class: "sr-only",
                  data: { action: "change->checkout#shippingTypeChanged" } %>
            <span class="material-symbols-outlined text-3xl text-stone-700">local_shipping</span>
            <p class="font-semibold text-sm">Delivery</p>
            <p class="text-xs text-stone-400">Envío a domicilio</p>
          </label>
        </div>

        <!-- Sección de dirección — solo visible en delivery -->
        <div data-checkout-target="shippingSection"
             class="<%= @order.shipping_type == 'delivery' ? '' : 'hidden' %> space-y-5 border-t border-stone-200 pt-6">

          <%# ── Direcciones guardadas ── %>
          <% if @addresses.present? && @addresses.any? %>
            <div>
              <p class="text-[10px] font-bold tracking-widest uppercase text-stone-400 mb-3">Mis direcciones guardadas</p>
              <div class="space-y-2" id="saved-addresses">
                <% @addresses.each do |addr| %>
                  <button type="button"
                          class="w-full text-left flex items-start gap-3 p-3.5 rounded-xl
                                 border-2 border-stone-200 hover:border-stone-400 transition-colors group"
                          data-action="click->checkout#fillAddress"
                          data-recipient="<%= addr.recipient_name %>"
                          data-phone="<%= addr.phone %>"
                          data-region="<%= addr.region %>"
                          data-comuna="<%= addr.comuna %>"
                          data-city="<%= addr.city %>"
                          data-street="<%= addr.street %>"
                          data-street-number="<%= addr.street_number %>"
                          data-apartment="<%= addr.apartment %>">
                    <span class="material-symbols-outlined text-stone-400 group-hover:text-stone-700 mt-0.5 shrink-0">location_on</span>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2">
                        <span class="text-sm font-semibold text-stone-700"><%= addr.label %></span>
                        <% if addr.default? %>
                          <span class="text-[10px] px-2 py-0.5 bg-stone-100 text-stone-500 rounded-full font-semibold uppercase tracking-wide">Predeterminada</span>
                        <% end %>
                      </div>
                      <p class="text-xs text-stone-500 truncate mt-0.5">
                        <%= addr.street %> <%= addr.street_number %><%= addr.apartment.present? ? ", #{addr.apartment}" : "" %>, <%= addr.comuna %>, <%= addr.region %>
                      </p>
                    </div>
                    <span class="material-symbols-outlined text-stone-300 group-hover:text-stone-600 shrink-0">chevron_right</span>
                  </button>
                <% end %>
              </div>
              <!-- Botón para ingresar dirección nueva -->
              <button type="button"
                      class="mt-3 w-full flex items-center justify-center gap-2 py-3 rounded-xl
                             border-2 border-dashed border-stone-200 text-sm text-stone-500
                             hover:border-stone-400 hover:text-stone-700 transition-colors"
                      data-action="click->checkout#newAddress">
                <span class="material-symbols-outlined text-base">add_location_alt</span>
                Ingresar una dirección diferente
              </button>
            </div>
          <% end %>

          <%# ── Formulario de dirección ── %>
          <%# Si tiene direcciones guardadas: empieza oculto, se muestra al elegir o crear nueva %>
          <%# Si no tiene: siempre visible %>
          <div data-checkout-target="addressForm"
               class="<%= (@addresses.present? && @addresses.any? && @order.shipping_street.blank?) ? 'hidden' : '' %> space-y-5">

            <p class="text-[10px] font-bold tracking-widest uppercase text-stone-400">Dirección de entrega</p>

            <div class="grid grid-cols-2 gap-5">
              <div class="border-b border-stone-300 focus-within:border-stone-900 transition-colors pb-1">
                <label class="block text-[10px] font-semibold tracking-widest uppercase text-stone-400 mb-1">Nombre destinatario</label>
                <%= f.text_field :shipping_recipient_name,
                      autocomplete: "name", placeholder: "Quien recibe",
                      class: "w-full bg-transparent border-none p-0 focus:ring-0 text-base" %>
              </div>
              <div>
                <%= render "checkout/phone_field",
                      f: f, field: :shipping_phone,
                      label_text: "Teléfono",
                      required: false,
                      value: @order.shipping_phone %>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-5">
              <div class="border-b border-stone-300 focus-within:border-stone-900 transition-colors pb-1">
                <label class="block text-[10px] font-semibold tracking-widest uppercase text-stone-400 mb-1">Región</label>
                <%= f.select :shipping_region,
                      [["— Región —", ""]] + Address::REGIONS.keys.map { |r| [r, r] },
                      {},
                      class: "w-full bg-transparent border-none p-0 focus:ring-0 text-base cursor-pointer",
                      data: { action: "change->checkout#regionChanged", checkout_target: "regionSelect" } %>
              </div>
              <div class="border-b border-stone-300 focus-within:border-stone-900 transition-colors pb-1">
                <label class="block text-[10px] font-semibold tracking-widest uppercase text-stone-400 mb-1">Comuna</label>
                <select name="order[shipping_comuna]" id="order_shipping_comuna"
                        class="w-full bg-transparent border-none p-0 focus:ring-0 text-base cursor-pointer"
                        data-checkout-target="comunaSelect"
                        data-selected="<%= @order.shipping_comuna %>">
                  <option value="">— Selecciona una comuna —</option>
                  <% Address::REGIONS[@order.shipping_region.to_s]&.each do |c| %>
                    <option value="<%= c %>" <%= "selected" if @order.shipping_comuna == c %>><%= c %></option>
                  <% end %>
                </select>
              </div>
            </div>

            <div class="border-b border-stone-300 focus-within:border-stone-900 transition-colors pb-1">
              <label class="block text-[10px] font-semibold tracking-widest uppercase text-stone-400 mb-1">Ciudad</label>
              <%= f.text_field :shipping_city, autocomplete: "address-level2",
                    placeholder: "Ej: Santiago", class: "w-full bg-transparent border-none p-0 focus:ring-0 text-base" %>
            </div>

            <div class="grid grid-cols-2 gap-5">
              <div class="border-b border-stone-300 focus-within:border-stone-900 transition-colors pb-1">
                <label class="block text-[10px] font-semibold tracking-widest uppercase text-stone-400 mb-1">Calle</label>
                <%= f.text_field :shipping_street, placeholder: "Ej: Av. Providencia",
                      class: "w-full bg-transparent border-none p-0 focus:ring-0 text-base" %>
              </div>
              <div class="border-b border-stone-300 focus-within:border-stone-900 transition-colors pb-1">
                <label class="block text-[10px] font-semibold tracking-widest uppercase text-stone-400 mb-1">Número</label>
                <%= f.text_field :shipping_street_number, placeholder: "Ej: 1234",
                      class: "w-full bg-transparent border-none p-0 focus:ring-0 text-base" %>
              </div>
            </div>

            <!-- Departamento / Piso — siempre visible; checkbox lo oculta si es casa -->
            <div data-checkout-target="apartmentWrapper"
                 class="border-b border-stone-300 focus-within:border-stone-900 transition-colors pb-1">
              <label class="block text-[10px] font-semibold tracking-widest uppercase text-stone-400 mb-1">Departamento / Piso</label>
              <%= f.text_field :shipping_apartment, placeholder: "Ej: Depto 4B, Piso 3",
                    class: "w-full bg-transparent border-none p-0 focus:ring-0 text-base",
                    data: { checkout_target: "apartmentField" } %>
            </div>

            <label class="flex items-center gap-2.5 cursor-pointer select-none w-fit">
              <input type="checkbox" class="w-4 h-4 rounded accent-stone-900"
                     <%= "checked" if @order.shipping_apartment.blank? && @order.shipping_street.present? %>
                     data-action="change->checkout#toggleApartment">
              <span class="text-sm text-stone-500">Es casa (sin número de departamento o piso)</span>
            </label>

            <!-- Guardar dirección -->
            <div class="pt-2 border-t border-dashed border-stone-200">
              <label class="flex items-start gap-3 cursor-pointer group">
                <input type="checkbox" name="save_address" value="1"
                       class="w-4 h-4 mt-0.5 rounded accent-stone-900 shrink-0">
                <div>
                  <span class="text-sm font-medium text-stone-700 group-hover:text-stone-900">Guardar esta dirección</span>
                  <p class="text-xs text-stone-400 mt-0.5">Podrás usarla en próximas compras sin volver a escribirla.</p>
                </div>
              </label>
              <div class="mt-3 ml-7 border-b border-stone-300 focus-within:border-stone-900 pb-1">
                <label class="block text-[10px] font-semibold tracking-widest uppercase text-stone-400 mb-1">Nombre (opcional)</label>
                <input type="text" name="address_label" placeholder="Ej: Casa, Trabajo, Casa de mamá"
                       class="w-full bg-transparent border-none p-0 focus:ring-0 text-sm">
              </div>
            </div>

          </div><!-- /addressForm -->

        </div><!-- /shippingSection -->

        <!-- Botones de navegación — SIEMPRE visibles en paso 2 -->
        <div class="mt-10 flex gap-3">
          <button type="button" data-action="click->checkout#back"
                  class="flex-1 border border-stone-300 text-stone-700 py-4 rounded-xl
                         font-semibold hover:bg-stone-50 transition-all">
            ← Volver
          </button>
          <button type="button" data-action="click->checkout#next"
                  class="flex-[2] bg-stone-900 text-white py-4 rounded-xl font-semibold
                         tracking-wide hover:bg-stone-700 active:scale-[0.98] transition-all">
            Continuar con Pago →
          </button>
        </div>

      </div>
    </div>


    <!-- ══════════════════════════════════════════════════
         PASO 3 — CONFIRMAR
    ══════════════════════════════════════════════════ -->
    <div data-checkout-target="step" class="hidden">
      <div class="max-w-2xl mx-auto">

        <div class="mb-8">
          <h1 class="text-2xl font-bold">Confirmar Pedido</h1>
          <p class="text-sm text-stone-500 mt-1">Revisa tu información antes de pagar.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-6">

          <!-- Resumen facturación -->
          <div class="bg-stone-50 rounded-2xl p-5 border border-stone-200">
            <div class="flex items-center justify-between mb-3">
              <p class="text-[10px] font-bold tracking-widest uppercase text-stone-400">Facturación</p>
              <button type="button" data-step="0" data-action="click->checkout#goToStep"
                      class="text-xs text-stone-600 hover:underline">Editar</button>
            </div>
            <div class="space-y-1 text-sm text-stone-700">
              <p><span class="text-stone-400">Nombre: </span><span class="font-medium" data-checkout-target="summaryFirstName">—</span></p>
              <p><span class="text-stone-400">Documento: </span><span class="font-medium" data-checkout-target="summaryDocument">—</span></p>
              <p><span class="text-stone-400">Email: </span><span class="font-medium" data-checkout-target="summaryEmail">—</span></p>
              <p><span class="text-stone-400">Teléfono: </span><span class="font-medium" data-checkout-target="summaryPhone">—</span></p>
            </div>
          </div>

          <!-- Resumen envío — se oculta si es pickup -->
          <div class="bg-stone-50 rounded-2xl p-5 border border-stone-200"
               data-checkout-target="shippingCard">
            <div class="flex items-center justify-between mb-3">
              <p class="text-[10px] font-bold tracking-widest uppercase text-stone-400">Envío</p>
              <button type="button" data-step="1" data-action="click->checkout#goToStep"
                      class="text-xs text-stone-600 hover:underline">Editar</button>
            </div>
            <div class="space-y-1 text-sm text-stone-700">
              <p><span class="text-stone-400">Tipo: </span><span class="font-medium" data-checkout-target="summaryShipping">—</span></p>
              <p class="text-stone-500 text-xs leading-relaxed mt-1" data-checkout-target="summaryAddress"></p>
            </div>
          </div>

        </div>

        <!-- Productos -->
        <div class="bg-white border border-stone-200 rounded-2xl p-6 mb-5 shadow-sm">
          <h3 class="font-semibold mb-4">Productos del pedido</h3>
          <div class="space-y-4 max-h-60 overflow-y-auto pr-1">
            <% @cart.order_items.includes(:product).each do |item| %>
              <div class="flex gap-4 items-center">
                <div class="w-14 h-14 bg-stone-100 rounded-xl overflow-hidden shrink-0">
                  <% if item.product.image.attached? %>
                    <%= image_tag item.product.image, alt: item.product.name, class: "w-full h-full object-cover" %>
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center">
                      <span class="material-symbols-outlined text-stone-300">inventory_2</span>
                    </div>
                  <% end %>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium truncate"><%= item.product.name %></p>
                  <p class="text-xs text-stone-400">Cantidad: <%= item.quantity %></p>
                </div>
                <p class="text-sm font-semibold shrink-0"><%= humanized_money_with_symbol(item.total_price) %></p>
              </div>
            <% end %>
          </div>
          <div class="border-t border-stone-100 mt-4 pt-4 space-y-2">
            <div class="flex justify-between text-sm text-stone-500">
              <span>Subtotal (<%= @cart.item_count %> productos)</span>
              <span><%= humanized_money_with_symbol(@cart.subtotal) %></span>
            </div>
            <div class="flex justify-between text-sm text-stone-500">
              <span>Envío</span>
              <span class="text-stone-700 font-medium text-xs">Por confirmar</span>
            </div>
            <div class="flex justify-between pt-3 border-t border-stone-100">
              <span class="text-lg font-bold">Total</span>
              <span class="text-lg font-bold"><%= humanized_money_with_symbol(@cart.total) %></span>
            </div>
          </div>
        </div>

        <!-- Método de pago -->
        <div class="bg-stone-50 rounded-2xl p-5 border border-stone-200 mb-8">
          <p class="text-[10px] font-bold tracking-widest uppercase text-stone-400 mb-4">Método de Pago</p>
          <div class="grid grid-cols-2 gap-3">
            <label class="flex items-center gap-3 p-4 border-2 border-stone-200 rounded-xl cursor-pointer
                          hover:border-stone-400 has-[:checked]:border-stone-900 has-[:checked]:bg-white transition-colors">
              <input type="radio" name="payment_method" value="getnet" checked class="accent-stone-900">
              <div>
                <img src="https://banco.santander.cl/uploads/000/029/870/0620f532-9fc9-4248-b99e-78bae9f13e1d/original/Logo_WebCheckout_Getnet.svg"
                     alt="Getnet" class="h-5 mb-1">
                <p class="text-xs text-stone-400">Tarjeta crédito, débito o prepago</p>
              </div>
            </label>
            <label class="flex items-center gap-3 p-4 border-2 border-stone-200 rounded-xl cursor-pointer
                          hover:border-stone-400 has-[:checked]:border-stone-900 has-[:checked]:bg-white transition-colors">
              <input type="radio" name="payment_method" value="efectivo" class="accent-stone-900">
              <div>
                <p class="text-sm font-semibold">Efectivo</p>
                <p class="text-xs text-stone-400">Al retirar o recibir</p>
              </div>
            </label>
          </div>
        </div>

        <div class="flex gap-3">
          <button type="button" data-step="1" data-action="click->checkout#goToStep"
                  class="flex-1 border border-stone-300 text-stone-700 py-4 rounded-xl
                         font-semibold hover:bg-stone-50 transition-all">
            ← Volver
          </button>
          <%= f.submit "Confirmar y Pagar →",
                class: "flex-[2] bg-stone-900 text-white py-4 rounded-xl font-semibold
                        tracking-wide hover:bg-stone-700 active:scale-[0.98] transition-all cursor-pointer" %>
        </div>

        <p class="text-center mt-5 text-xs text-stone-400 flex items-center justify-center gap-1.5">
