<% content_for :page_title, "Editar atención #{@attendance.number}" %>

<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px;">
  <div>
    <h1 style="font-size:20px; font-weight:700;">Editar atención</h1>
    <p style="font-size:13px; color:#9ca3af; margin-top:2px;"><code><%= @attendance.number %></code> · <%= @attendance.attended_on.strftime("%d/%m/%Y") %></p>
  </div>
  <%= link_to "← Volver", supervisor_attendance_path(@attendance), class: "btn btn-outline" %>
</div>

<%= render "form", attendance: @attendance %>
