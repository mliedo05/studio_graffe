<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mi Panel — Studio Graffé</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", media: "all" %>
  <%= javascript_importmap_tags %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', sans-serif; background: #FAFAF8; color: #1A1A1A; }
    .sp-header {
      background: #1A1A1A; color: #fff;
      padding: 0 24px; height: 56px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .sp-header-brand { font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: #C9A96E; }
    .sp-header-brand strong { color: #fff; font-size: 15px; margin-left: 8px; }
    .sp-header-nav { display: flex; gap: 4px; }
    .sp-header-nav a {
      padding: 6px 14px; border-radius: 6px; font-size: 13px; color: rgba(255,255,255,0.7);
      text-decoration: none; transition: all 0.15s;
    }
    .sp-header-nav a:hover, .sp-header-nav a.active { color: #fff; background: rgba(201,169,110,0.2); }
    .sp-header-user { font-size: 12px; color: rgba(255,255,255,0.5); display: flex; align-items: center; gap: 12px; }
    .sp-header-user a { color: #C9A96E; text-decoration: none; font-size: 12px; }
    .sp-content { max-width: 1100px; margin: 0 auto; padding: 32px 24px; }
    .sv-flash { padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 13px; }
    .sv-flash-notice { background: #dcfce7; color: #166534; }
    .sv-flash-alert  { background: #fee2e2; color: #991b1b; }
    .sv-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 28px; }
    .sv-card { background: #fff; border: 1px solid #E5E5E0; border-radius: 10px; padding: 20px; }
    .sv-card-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #9ca3af; margin-bottom: 8px; }
    .sv-card-value { font-size: 26px; font-weight: 800; color: #1A1A1A; line-height: 1; }
    .sv-card-sub   { font-size: 13px; color: #9ca3af; margin-top: 6px; }
    .sv-table-wrap { background: #fff; border: 1px solid #E5E5E0; border-radius: 10px; overflow: hidden; }
    .sv-table-head { padding: 16px 20px; border-bottom: 1px solid #E5E5E0; }
    .sv-table-head h3 { font-size: 14px; font-weight: 600; }
    .sv-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .sv-table th { padding: 10px 16px; text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: #9ca3af; background: #f9fafb; border-bottom: 1px solid #E5E5E0; }
    .sv-table td { padding: 12px 16px; border-bottom: 1px solid #f3f4f6; vertical-align: middle; }
    .sv-table tr:last-child td { border-bottom: none; }
    .chart-wrap { background: #fff; border: 1px solid #E5E5E0; border-radius: 10px; padding: 20px; margin-bottom: 24px; }
    .chart-wrap h3 { font-size: 14px; font-weight: 600; margin-bottom: 16px; }
  </style>
</head>
<body>
<header class="sp-header">
  <div style="display:flex; align-items:center; gap:16px;">
    <span class="sp-header-brand">Studio Graffé <strong>Mi Panel</strong></span>
    <nav class="sp-header-nav">
      <%= link_to "📊 Inicio", stylist_panel_root_path,
            class: current_page?(stylist_panel_root_path) ? "active" : "" %>
      <%= link_to "💰 Comisiones", stylist_panel_commissions_path,
            class: controller_path == "stylist_panel/commissions" ? "active" : "" %>
    </nav>
  </div>
  <div class="sp-header-user">
    <span><%= current_user.full_name %></span>
    <%= link_to "← Sitio", root_path %>
    <%= button_to "Salir", destroy_user_session_path, method: :delete,
          style: "background:none; border:none; color:#C9A96E; cursor:pointer; font-size:12px; padding:0;" %>
  </div>
</header>
<main class="sp-content">
  <% if notice.present? %>
    <div class="sv-flash sv-flash-notice"><%= notice %></div>
  <% end %>
  <% if alert.present? %>
    <div class="sv-flash sv-flash-alert"><%= alert %></div>
  <% end %>
  <%= yield %>
</main>
</body>
</html>
