  function initPhoneSelect(id, selectedCode, countries) {
    var el = document.getElementById(id);
    if (!el || el.tomselect) return;

    // Build options
    countries.forEach(function(c) {
      var opt = document.createElement("option");
      opt.value = c.c;
      opt.text  = c.f + " " + c.n + " (" + c.c + ")";
      opt.dataset.flag = c.f;
      opt.dataset.name = c.n;
      opt.dataset.code = c.c;
      if (c.c === selectedCode) opt.selected = true;
      el.appendChild(opt);
    });

    new TomSelect(el, {
      maxOptions: 300,
      searchField: ["text"],   // searches flag + name + code
      render: {
        option: function(data) {
          return '<div style="display:flex;align-items:center;gap:8px;padding:4px 0">' +
                 '<span style="font-size:1.2em;line-height:1">' + data.flag + '</span>' +
                 '<span style="flex:1">' + data.name + '</span>' +
                 '<span style="color:#888;font-size:.85em;white-space:nowrap">' + data.code + '</span>' +
                 '</div>';
        },
        item: function(data) {
          return '<div style="display:flex;align-items:center;gap:6px">' +
                 '<span>' + data.flag + '</span>' +
                 '<span style="color:#555;font-size:.9em">' + data.code + '</span>' +
                 '</div>';
        }
      },
      onInitialize: function() {
        // Fix Tom Select wrapper styles to match our design
        var wrapper = el.nextElementSibling;
        if (wrapper && wrapper.classList.contains("ts-wrapper")) {
          wrapper.style.cssText = "border:none;box-shadow:none;min-width:90px;max-width:130px;cursor:pointer";
          var control = wrapper.querySelector(".ts-control");
          if (control) {
            control.style.cssText = "border:none!important;box-shadow:none!important;background:transparent;padding:0;min-height:0;cursor:pointer";
          }
        }
      }
    });
  }
