<% content_for :page_title, "Atención #{@attendance.number}" %>

<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px;">
  <div>
    <h1 style="font-size:20px; font-weight:700;">
      <code style="font-size:18px; background:#f3f4f6; padding:4px 10px; border-radius:6px;"><%= @attendance.number %></code>
    </h1>
    <p style="font-size:13px; color:#9ca3af; margin-top:4px;">
      <%= @attendance.attended_on.strftime("%A %d de %B, %Y").capitalize %> ·
      Registrada por <%= @attendance.registered_by.full_name %>
    </p>
  </div>
  <div style="display:flex; gap:8px;">
    <%= link_to "Editar", edit_supervisor_attendance_path(@attendance), class: "btn btn-outline" %>
    <% if @attendance.status == "open" %>
      <%= button_to "✓ Cerrar atención", close_supervisor_attendance_path(@attendance),
            method: :patch, class: "btn btn-gold",
            data: { confirm: "¿Confirmar cierre de esta atención?" } %>
    <% end %>
    <%= button_to "🗑 Eliminar", supervisor_attendance_path(@attendance),
          method: :delete, class: "btn",
          style: "background:#fee2e2; color:#dc2626; border:1px solid #fca5a5;",
          data: { confirm: "¿Eliminar la atención #{@attendance.number}?\n\nEsto restaurará automáticamente:\n· Inventario de productos vendidos (+1 unidad por producto)\n· Stock de insumos de salón utilizados (+gramos descontados)\n· Se eliminarán pagos y comisiones registrados\n\nEsta acción NO se puede deshacer." } %>
    <%= link_to "← Lista", supervisor_attendances_path, class: "btn btn-outline" %>
  </div>
</div>

<div style="display:grid; grid-template-columns:2fr 1fr; gap:20px;">

  <!-- Servicios y productos -->
  <div>
    <div class="sv-table-wrap" style="margin-bottom:20px;">
      <div class="sv-table-head">
        <h3>✂️ Servicios y productos</h3>
      </div>
      <table class="sv-table">
        <thead>
          <tr><th>Descripción</th><th>Tipo</th><th>Estilista</th><th>Precio</th><th>Insumo</th><th>Comisión %</th><th>Comisión $</th></tr>
        </thead>
        <tbody>
          <% @items.each do |item| %>
            <tr>
              <td style="font-weight:500;">
                <%= item.description %>
                <% if item.uses_insumo? %>
                  <div style="font-size:11px; color:#c2410c; margin-top:2px;">
                    🧴 <%= item.consumed_product.brand %> — <%= item.consumed_product.name %>
                    (<%= item.grams_used.to_f.to_s.delete_suffix(".0") %> gr)
                  </div>
                <% end %>
              </td>
              <td>
                <span class="badge <%= item.service? ? "badge-yellow" : "badge-blue" %>">
                  <%= item.service? ? "Servicio" : "Producto" %>
                </span>
              </td>
              <td><%= item.stylist.full_name %></td>
              <td style="font-weight:600;"><%= number_to_currency(item.price_cents, unit: "$", delimiter: ".", precision: 0) %></td>
              <td>
                <% if item.uses_insumo? %>
                  <span style="color:#c2410c; font-weight:600; font-size:12px;">
                    − <%= number_to_currency(item.product_cost_cents, unit: "$", delimiter: ".", precision: 0) %>
                  </span>
                <% else %>
                  <span style="color:#9ca3af; font-size:12px;">—</span>
                <% end %>
              </td>
              <td><%= item.commission_percent %>%</td>
              <td style="color:#C9A96E; font-weight:600;"><%= number_to_currency(item.commission_cents, unit: "$", delimiter: ".", precision: 0) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr style="background:#f9fafb; font-weight:700;">
            <td colspan="3" style="text-align:right; padding:12px 16px;">Total atención:</td>
            <td style="font-size:16px;"><%= number_to_currency(@attendance.total_cents , unit: "$", delimiter: ".", precision: 0) %></td>
            <td></td>
            <td></td>
            <td style="color:#C9A96E; font-size:16px;"><%= number_to_currency(@attendance.total_commission_cents , unit: "$", delimiter: ".", precision: 0) %></td>
          </tr>
        </tfoot>
      </table>
    </div>

    <!-- Resumen por estilista -->
    <% by_stylist = @items.group_by { |i| i.stylist.full_name } %>
    <div class="sv-table-wrap">
      <div class="sv-table-head"><h3>👤 Desglose por estilista</h3></div>
      <table class="sv-table">
        <thead><tr><th>Estilista</th><th>Items</th><th>Subtotal</th><th>Comisión</th></tr></thead>
        <tbody>
          <% by_stylist.each do |name, items| %>
            <tr>
              <td style="font-weight:500;"><%= name %></td>
              <td><%= items.count %></td>
              <td><%= number_to_currency(items.sum(&:price_cents) , unit: "$", delimiter: ".", precision: 0) %></td>
              <td style="color:#C9A96E; font-weight:600;"><%= number_to_currency(items.sum(&:commission_cents) , unit: "$", delimiter: ".", precision: 0) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Panel derecho: info + pagos -->
  <div>
    <!-- Info cliente -->
    <div style="background:#fff; border:1px solid #E5E5E0; border-radius:10px; padding:20px; margin-bottom:16px;">
      <h3 style="font-size:13px; font-weight:600; margin-bottom:12px;">👤 Cliente</h3>
      <p style="font-size:14px; font-weight:600;"><%= @attendance.display_client_name %></p>
      <% if @attendance.client %>
        <p style="font-size:12px; color:#9ca3af;"><%= @attendance.client.email %></p>
      <% end %>
      <% if @attendance.notes.present? %>
        <p style="font-size:12px; color:#6b7280; margin-top:8px; padding-top:8px; border-top:1px solid #f3f4f6;"><%= @attendance.notes %></p>
      <% end %>
    </div>

    <!-- Pagos -->
    <div style="background:#fff; border:1px solid #E5E5E0; border-radius:10px; padding:20px; margin-bottom:16px;">
      <h3 style="font-size:13px; font-weight:600; margin-bottom:12px;">💳 Pagos</h3>
      <% @payments.each do |pay| %>
        <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid #f3f4f6; font-size:13px;">
          <span>
            <%= pay.method_label %>
            <% if pay.note.present? %><span style="color:#9ca3af;"> · <%= pay.note %></span><% end %>
          </span>
          <strong><%= number_to_currency(pay.amount_cents , unit: "$", delimiter: ".", precision: 0) %></strong>
        </div>
      <% end %>
      <div style="display:flex; justify-content:space-between; padding:10px 0 4px; font-size:13px;">
        <span>Total atención</span>
        <strong><%= number_to_currency(@attendance.total_cents , unit: "$", delimiter: ".", precision: 0) %></strong>
      </div>
      <div style="display:flex; justify-content:space-between; font-size:13px;">
        <span>Pagado</span>
        <strong style="color:#16a34a;"><%= number_to_currency(@attendance.paid_cents , unit: "$", delimiter: ".", precision: 0) %></strong>
      </div>
      <% if @attendance.balance_cents > 0 %>
        <div style="display:flex; justify-content:space-between; font-size:14px; font-weight:700; margin-top:8px; padding-top:8px; border-top:2px solid #f3f4f6; color:#dc2626;">
          <span>Saldo pendiente</span>
          <span><%= number_to_currency(@attendance.balance_cents , unit: "$", delimiter: ".", precision: 0) %></span>
        </div>
      <% end %>
    </div>

    <!-- Estado -->
    <div style="background:#fff; border:1px solid #E5E5E0; border-radius:10px; padding:16px;">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <span style="font-size:13px; font-weight:600;">Estado</span>
        <span class="badge <%= @attendance.status == "closed" ? "badge-green" : "badge-yellow" %>">
          <%= @attendance.status == "closed" ? "✅ Cerrada" : "🟡 Abierta" %>
        </span>
      </div>
    </div>

    <!-- Ficha técnica -->
    <% sheet = @attendance.technical_sheet %>
    <div style="background:#fff; border:1px solid #E5E5E0; border-radius:10px; overflow:hidden;">
      <div style="padding:14px 16px; background:#fefce8; border-bottom:1px solid #fef08a; display:flex; justify-content:space-between; align-items:center;">
        <span style="font-size:13px; font-weight:700; color:#713f12;">🧪 Ficha técnica</span>
        <%= link_to "✏️ #{sheet ? "Editar" : "Completar"}",
              edit_supervisor_technical_sheet_path(@attendance),
              style: "font-size:12px; color:#92400e; font-weight:600; text-decoration:none; background:#fef3c7; padding:4px 10px; border-radius:6px; border:1px solid #fde68a;" %>
      </div>
      <% if sheet %>
        <div style="padding:14px 16px; font-size:13px; display:flex; flex-direction:column; gap:8px;">
          <% if sheet.technique.present? %>
            <div style="display:flex; justify-content:space-between;">
              <span style="color:#6b7280;">Técnica</span>
              <span style="font-weight:600; color:#111827;"><%= sheet.technique.humanize %></span>
            </div>
          <% end %>
          <% if sheet.tint_brand.present? %>
            <div style="display:flex; justify-content:space-between;">
              <span style="color:#6b7280;">Marca</span>
              <span style="font-weight:600; color:#111827;"><%= sheet.tint_brand %></span>
            </div>
          <% end %>
          <% if sheet.tint_formula.present? %>
            <div style="display:flex; justify-content:space-between; gap:12px;">
              <span style="color:#6b7280; white-space:nowrap;">Fórmula</span>
              <span style="font-weight:500; color:#111827; text-align:right;"><%= sheet.tint_formula %></span>
            </div>
          <% end %>
          <% if sheet.decolorization_applied? %>
            <div style="border-top:1px solid #f3f4f6; padding-top:8px; margin-top:2px;">
              <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                <span style="color:#6b7280;">Decoloración</span>
                <span style="font-weight:600; color:#92400e;">⚡ Sí</span>
              </div>
              <% if sheet.decolorization_height.present? %>
                <div style="display:flex; justify-content:space-between;">
                  <span style="color:#6b7280;">Altura</span>
                  <span style="font-weight:500;"><%= sheet.decolorization_height_label %></span>
                </div>
              <% end %>
              <% if sheet.decolorization_level_start.present? || sheet.decolorization_level_achieved.present? %>
                <div style="display:flex; justify-content:space-between;">
                  <span style="color:#6b7280;">Niveles</span>
                  <span style="font-weight:500;"><%= sheet.decolorization_level_start || "?" %> → <%= sheet.decolorization_level_achieved || "?" %></span>
                </div>
              <% end %>
            </div>
          <% end %>
          <% if sheet.hair_elasticity.present? %>
            <div style="display:flex; justify-content:space-between;">
              <span style="color:#6b7280;">Elasticidad</span>
              <span style="font-weight:500; <%= sheet.hair_elasticity == "elastico" ? "color:#dc2626;" : "color:#111827;" %>">
                <%= sheet.elasticity_label %>
              </span>
            </div>
          <% end %>
          <% if sheet.hair_porosity.present? %>
            <div style="display:flex; justify-content:space-between;">
              <span style="color:#6b7280;">Porosidad</span>
              <span style="font-weight:500;"><%= sheet.porosity_label %></span>
            </div>
          <% end %>
          <% if sheet.notes.present? %>
            <div style="border-top:1px solid #f3f4f6; padding-top:8px; margin-top:2px;">
              <span style="color:#6b7280; display:block; margin-bottom:4px;">Notas</span>
              <p style="color:#374151; font-size:13px; margin:0; line-height:1.5;"><%= sheet.notes %></p>
            </div>
          <% end %>
        </div>
      <% else %>
        <div style="padding:16px; text-align:center; color:#9ca3af; font-size:13px;">
          Sin ficha técnica. <%= link_to "Completar ahora →", edit_supervisor_technical_sheet_path(@attendance), style: "color:#C9A96E;" %>
        </div>
      <% end %>
    </div>
  </div>

</div>
