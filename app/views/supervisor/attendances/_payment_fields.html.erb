<div class="payment-row" style="display:grid; grid-template-columns:1fr 1fr 1fr auto; gap:8px; align-items:end; margin-bottom:8px;">
  <%= f.hidden_field :_destroy, class: "destroy-field" %>

  <div>
    <label style="font-size:11px; color:#9ca3af; font-weight:600; display:block; margin-bottom:3px;">Método</label>
    <%= f.select :payment_method,
          AttendancePayment::METHODS.map { |m| [AttendancePayment::METHOD_LABELS[m], m] },
          {},
          class: "sv-select" %>
  </div>
  <div>
    <label style="font-size:11px; color:#9ca3af; font-weight:600; display:block; margin-bottom:3px;">Monto $</label>
    <%= f.number_field :amount_cents, class: "sv-input payment-amount", min: 0, value: f.object.amount_cents || 0, oninput: "updateTotals()" %>
  </div>
  <div>
    <label style="font-size:11px; color:#9ca3af; font-weight:600; display:block; margin-bottom:3px;">Nota</label>
    <%= f.text_field :note, class: "sv-input", placeholder: "Ej: abono, saldo" %>
  </div>
  <button type="button" onclick="removePayment(this)"
          style="background:#fee2e2; color:#dc2626; border:none; border-radius:6px; width:32px; height:32px; cursor:pointer; font-size:16px; margin-bottom:2px;">×</button>
</div>
