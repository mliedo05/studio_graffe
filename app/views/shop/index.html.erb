<main class="pt-20 min-h-screen flex">
  <%= render "sidebar", categories: @categories, brands: @brands,
        current_category: nil, current_brand: nil %>

  <!-- Main Content Area -->
  <section class="flex-1 px-8 py-12 md:px-16 lg:px-24">
    <!-- Header -->
    <div class="mb-12 border-b border-amber-200/50 pb-4 text-center">
      <span class="font-label-caps text-label-caps text-on-secondary-container tracking-[0.3em]">Bienvenida a Studio Graffé</span>
    </div>

    <% if @products.empty? %>
      <div class="py-24 text-center flex flex-col items-center gap-6 border-2 border-dashed border-outline-variant/20 rounded-xl">
        <span class="material-symbols-outlined text-stone-200 text-6xl">shopping_basket</span>
        <p class="font-h3 text-stone-400">No hay productos disponibles</p>
        <%= link_to "Ver todas las categorías", shop_path,
              class: "px-8 py-3 bg-primary text-on-primary rounded-full font-label-caps uppercase tracking-widest hover:scale-105 transition-transform" %>
      </div>
    <% else %>
      <!-- Product Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16">
        <% @products.each do |product| %>
          <%= render "shop/product_card", product: product %>
        <% end %>
      </div>

      <!-- Pagination -->
      <% if @pagy && @pagy.pages > 1 %>
        <nav class="mt-24 flex justify-center items-center gap-12 font-serif text-sm tracking-[0.2em] uppercase">
          <% if @pagy.prev %>
            <%= link_to shop_path(page: @pagy.prev), class: "text-black flex items-center gap-2 hover:-translate-x-1 transition-transform" do %>
              <span class="material-symbols-outlined text-base">chevron_left</span>
              Anterior
            <% end %>
          <% else %>
            <span class="text-stone-300 cursor-not-allowed flex items-center gap-2">
              <span class="material-symbols-outlined text-base">chevron_left</span>
              Anterior
            </span>
          <% end %>

          <div class="flex gap-6">
            <% (1..@pagy.pages).each do |page| %>
              <% if page == @pagy.page %>
                <span class="text-amber-600 border-b border-amber-600 px-1"><%= page %></span>
              <% else %>
                <%= link_to page, shop_path(page: page), class: "text-stone-400 hover:text-black transition-colors" %>
              <% end %>
            <% end %>
          </div>

          <% if @pagy.next %>
            <%= link_to shop_path(page: @pagy.next), class: "text-black flex items-center gap-2 hover:translate-x-1 transition-transform" do %>
              Siguiente
              <span class="material-symbols-outlined text-base">chevron_right</span>
            <% end %>
          <% else %>
            <span class="text-stone-300 cursor-not-allowed flex items-center gap-2">
              Siguiente
              <span class="material-symbols-outlined text-base">chevron_right</span>
            </span>
          <% end %>
        </nav>
      <% end %>
    <% end %>
  </section>
</main>
