<% content_for :title, "Finalizar Compra — Studio Graffé" %>

<main class="pt-32 pb-section-padding px-4 sm:px-8 max-w-screen-xl mx-auto"
      data-controller="checkout">

  <header class="mb-10">
    <h1 class="font-h1 text-h1 mb-2">Finalizar Compra</h1>
    <p class="font-body-md text-on-surface-variant">Completa tus datos para confirmar el pedido.</p>
  </header>

  <%= form_with model: @order,
        url: checkout_payment_path,
        method: :post,
        local: true do |f| %>

    <%# Hidden field for form binding %>
    <%# Rails uses the model to build field names; we override url to go straight to payment %>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">

      <!-- ═══════════════════════════════════════════════════
           LEFT COLUMN: Billing + Shipping
      ═══════════════════════════════════════════════════ -->
      <div class="lg:col-span-7 space-y-10">

        <!-- ── 1. DATOS DE FACTURACIÓN ─────────────────────── -->
        <section class="bg-surface-container-low rounded-2xl p-6 sm:p-8 border border-outline-variant/50">
          <h2 class="font-h3 text-h3 mb-6 flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-primary text-on-primary text-sm font-bold flex items-center justify-center">1</span>
            Datos de Facturación
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-5">

            <!-- Nombre -->
            <div class="field-underline">
              <%= f.label :billing_first_name, "Nombre", class: "field-label" %>
              <%= f.text_field :billing_first_name,
                    required: true,
                    autocomplete: "given-name",
                    placeholder: "Ej: María",
                    class: "field-input" %>
            </div>

            <!-- Apellido -->
            <div class="field-underline">
              <%= f.label :billing_last_name, "Apellido", class: "field-label" %>
              <%= f.text_field :billing_last_name,
                    required: true,
                    autocomplete: "family-name",
                    placeholder: "Ej: González",
                    class: "field-input" %>
            </div>

            <!-- Tipo de documento -->
            <div class="field-underline">
              <%= f.label :billing_document_type, "Tipo de documento", class: "field-label" %>
              <%= f.select :billing_document_type,
                    [["RUT", "rut"], ["Pasaporte", "passport"], ["DNI", "dni"]],
                    { selected: @order.billing_document_type || "rut" },
                    required: true,
                    class: "field-input bg-transparent",
                    data: { action: "change->checkout#documentTypeChanged" } %>
            </div>

            <!-- Número de documento -->
            <div class="field-underline">
              <%= f.label :billing_document_number, "Número de documento", class: "field-label" %>
              <%= f.text_field :billing_document_number,
                    required: true,
                    placeholder: "Ej: 12.345.678-9",
                    class: "field-input",
                    data: { checkout_target: "documentNumber" } %>
            </div>

            <!-- Email -->
            <div class="field-underline">
              <%= f.label :billing_email, "Email", class: "field-label" %>
              <%= f.email_field :billing_email,
                    required: true,
                    autocomplete: "email",
                    placeholder: "tu@email.com",
                    class: "field-input" %>
            </div>

            <!-- Teléfono -->
            <div class="field-underline">
              <%= f.label :billing_phone, "Teléfono", class: "field-label" %>
              <div class="flex items-end gap-2">
                <span class="font-body-md text-on-surface-variant pb-1 shrink-0">+56</span>
                <%= f.telephone_field :billing_phone,
                      required: true,
                      autocomplete: "tel-national",
                      placeholder: "9 1234 5678",
                      pattern: "[0-9 ]{7,12}",
                      class: "field-input flex-1" %>
              </div>
            </div>

          </div>
        </section>

        <!-- ── 2. TIPO DE ENVÍO ────────────────────────────── -->
        <section class="bg-surface-container-low rounded-2xl p-6 sm:p-8 border border-outline-variant/50">
          <h2 class="font-h3 text-h3 mb-6 flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-primary text-on-primary text-sm font-bold flex items-center justify-center">2</span>
            Tipo de Envío
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">

            <!-- Retiro en tienda -->
            <label class="flex items-center gap-4 p-5 border border-outline-variant rounded-xl cursor-pointer
                          hover:bg-surface-container transition-colors
                          has-[:checked]:border-primary has-[:checked]:bg-surface-container">
              <%= f.radio_button :shipping_type, "pickup",
                    checked: (@order.shipping_type.blank? || @order.shipping_type == "pickup"),
                    class: "accent-primary w-5 h-5 shrink-0",
                    data: { action: "change->checkout#shippingTypeChanged" } %>
              <div>
                <p class="font-label-caps text-label-caps text-primary">Retiro en tienda</p>
                <p class="font-body-sm text-on-surface-variant mt-0.5">Gratis · Disponible en 2–3 días</p>
              </div>
              <span class="material-symbols-outlined ml-auto text-on-surface-variant">storefront</span>
            </label>

            <!-- Delivery -->
            <label class="flex items-center gap-4 p-5 border border-outline-variant rounded-xl cursor-pointer
                          hover:bg-surface-container transition-colors
                          has-[:checked]:border-primary has-[:checked]:bg-surface-container">
              <%= f.radio_button :shipping_type, "delivery",
                    checked: @order.shipping_type == "delivery",
                    class: "accent-primary w-5 h-5 shrink-0",
                    data: { action: "change->checkout#shippingTypeChanged" } %>
              <div>
                <p class="font-label-caps text-label-caps text-primary">Delivery</p>
                <p class="font-body-sm text-on-surface-variant mt-0.5">Envío a domicilio</p>
              </div>
              <span class="material-symbols-outlined ml-auto text-on-surface-variant">local_shipping</span>
            </label>

          </div>

          <!-- ── Formulario de dirección (solo visible en delivery) ── -->
          <div data-checkout-target="shippingSection"
               class="<%= @order.shipping_type == 'delivery' ? '' : 'hidden' %>
                      border-t border-outline-variant pt-6 space-y-5">

            <h3 class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest mb-1">Dirección de entrega</h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-5">

              <!-- Nombre del destinatario -->
              <div class="field-underline">
                <%= f.label :shipping_recipient_name, "Nombre del destinatario", class: "field-label" %>
                <%= f.text_field :shipping_recipient_name,
                      autocomplete: "name",
                      placeholder: "Quien recibe el pedido",
                      class: "field-input" %>
              </div>

              <!-- Teléfono destinatario -->
              <div class="field-underline">
                <%= f.label :shipping_phone, "Teléfono de contacto", class: "field-label" %>
                <div class="flex items-end gap-2">
                  <span class="font-body-md text-on-surface-variant pb-1 shrink-0">+56</span>
                  <%= f.telephone_field :shipping_phone,
                        autocomplete: "tel-national",
                        placeholder: "9 1234 5678",
                        class: "field-input flex-1" %>
                </div>
              </div>

              <!-- Región -->
              <div class="field-underline">
                <%= f.label :shipping_region, "Región", class: "field-label" %>
                <%= f.select :shipping_region,
                      [["— Selecciona una región —", ""]] + Address::REGIONS.keys.map { |r| [r, r] },
                      {},
                      class: "field-input bg-transparent",
                      data: {
                        action: "change->checkout#regionChanged",
                        checkout_target: "regionSelect"
                      } %>
              </div>

              <!-- Comuna -->
              <div class="field-underline">
                <%= f.label :shipping_comuna, "Comuna", class: "field-label" %>
                <select name="order[shipping_comuna]"
                        id="order_shipping_comuna"
                        class="field-input bg-transparent"
                        data-checkout-target="comunaSelect"
                        data-selected="<%= @order.shipping_comuna %>">
                  <option value="">— Selecciona una comuna —</option>
                  <% if @order.shipping_region.present? %>
                    <% Address::REGIONS[@order.shipping_region]&.each do |comuna| %>
                      <option value="<%= comuna %>" <%= "selected" if @order.shipping_comuna == comuna %>>
                        <%= comuna %>
                      </option>
                    <% end %>
                  <% end %>
                </select>
              </div>

              <!-- Ciudad -->
              <div class="field-underline sm:col-span-2">
                <%= f.label :shipping_city, "Ciudad", class: "field-label" %>
                <%= f.text_field :shipping_city,
                      autocomplete: "address-level2",
                      placeholder: "Ej: Santiago",
                      class: "field-input" %>
              </div>

              <!-- Calle -->
              <div class="field-underline">
                <%= f.label :shipping_street, "Calle", class: "field-label" %>
                <%= f.text_field :shipping_street,
                      autocomplete: "street-address",
                      placeholder: "Ej: Av. Providencia",
                      class: "field-input" %>
              </div>

              <!-- Número -->
              <div class="field-underline">
                <%= f.label :shipping_street_number, "Número", class: "field-label" %>
                <%= f.text_field :shipping_street_number,
                      placeholder: "Ej: 1234",
                      class: "field-input" %>
              </div>

              <!-- Toggle departamento -->
              <div class="sm:col-span-2">
                <label class="flex items-center gap-3 cursor-pointer select-none w-fit">
                  <input type="checkbox"
                         class="accent-primary w-4 h-4"
                         <%= "checked" if @order.shipping_apartment.present? %>
                         data-action="change->checkout#toggleApartment">
                  <span class="font-body-sm text-on-surface-variant">¿Tiene número de departamento o piso?</span>
                </label>
              </div>

              <!-- Campo departamento (hidden by default) -->
              <div data-checkout-target="apartmentWrapper"
                   class="sm:col-span-2 field-underline <%= @order.shipping_apartment.present? ? '' : 'hidden' %>">
                <%= f.label :shipping_apartment, "Departamento / Piso", class: "field-label" %>
                <%= f.text_field :shipping_apartment,
                      placeholder: "Ej: Depto 4B, Piso 3",
                      class: "field-input",
                      data: { checkout_target: "apartmentField" } %>
              </div>

            </div>
          </div>
        </section>

        <!-- ── 3. MÉTODO DE PAGO ───────────────────────────── -->
        <section class="bg-surface-container-low rounded-2xl p-6 sm:p-8 border border-outline-variant/50">
          <h2 class="font-h3 text-h3 mb-6 flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-primary text-on-primary text-sm font-bold flex items-center justify-center">3</span>
            Método de Pago
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label class="flex items-center gap-4 p-5 border border-outline-variant rounded-xl cursor-pointer
                          hover:bg-surface-container transition-colors
                          has-[:checked]:border-primary has-[:checked]:bg-surface-container">
              <input type="radio" name="payment_method" value="webpay" checked
                     class="accent-primary w-5 h-5 shrink-0">
              <div>
                <p class="font-label-caps text-label-caps text-primary">Webpay Plus</p>
                <p class="font-body-sm text-on-surface-variant mt-0.5">Débito, crédito y transferencia</p>
              </div>
              <span class="material-symbols-outlined ml-auto text-on-surface-variant">account_balance</span>
            </label>

            <label class="flex items-center gap-4 p-5 border border-outline-variant rounded-xl cursor-pointer
                          hover:bg-surface-container transition-colors
                          has-[:checked]:border-primary has-[:checked]:bg-surface-container">
              <input type="radio" name="payment_method" value="efectivo"
                     class="accent-primary w-5 h-5 shrink-0">
              <div>
                <p class="font-label-caps text-label-caps text-primary">Efectivo</p>
                <p class="font-body-sm text-on-surface-variant mt-0.5">Pago al retirar o al recibir</p>
              </div>
              <span class="material-symbols-outlined ml-auto text-on-surface-variant">payments</span>
            </label>
          </div>
        </section>

      </div><!-- /LEFT COLUMN -->


      <!-- ═══════════════════════════════════════════════════
           RIGHT COLUMN: Order Summary (sticky)
      ═══════════════════════════════════════════════════ -->
      <aside class="lg:col-span-5 lg:sticky lg:top-32 space-y-6">

        <div class="bg-white border border-stone-100 rounded-2xl p-6 sm:p-8 shadow-sm">
          <h3 class="font-h3 text-h3 mb-6">Resumen del Pedido</h3>

          <div class="space-y-5 mb-6 max-h-72 overflow-y-auto pr-1">
            <% @cart.order_items.includes(:product).each do |item| %>
              <div class="flex gap-4">
                <div class="w-16 h-16 bg-stone-100 rounded-lg overflow-hidden shrink-0">
                  <% if item.product.image.attached? %>
                    <%= image_tag item.product.image, alt: item.product.name, class: "w-full h-full object-cover" %>
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center">
                      <span class="material-symbols-outlined text-stone-300 text-xl">inventory_2</span>
                    </div>
                  <% end %>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="font-body-md font-medium truncate"><%= item.product.name %></p>
                  <p class="font-body-sm text-on-surface-variant">Cantidad: <%= item.quantity %></p>
                  <p class="font-body-sm font-medium mt-0.5">
                    <%= humanized_money_with_symbol(item.total_price) %>
                  </p>
                </div>
              </div>
            <% end %>
          </div>

          <div class="border-t border-stone-100 pt-5 space-y-3">
            <div class="flex justify-between text-on-surface-variant">
              <span class="font-body-md">Subtotal (<%= @cart.item_count %> productos)</span>
              <span class="font-body-md"><%= humanized_money_with_symbol(@cart.subtotal) %></span>
            </div>
            <div class="flex justify-between text-on-surface-variant">
              <span class="font-body-md">Envío</span>
              <span class="font-body-sm text-primary font-medium">Por confirmar</span>
            </div>
            <div class="flex justify-between pt-4 border-t border-stone-100">
              <span class="font-h3 text-h3">Total</span>
              <span class="font-h3 text-h3"><%= humanized_money_with_symbol(@cart.total) %></span>
            </div>
          </div>

          <%= f.submit "Confirmar pedido →",
                class: "w-full mt-8 bg-primary text-on-primary py-4 rounded-xl
                        font-label-caps text-label-caps hover:bg-stone-800
                        transition-all active:scale-[0.98] cursor-pointer
                        uppercase tracking-widest" %>

          <p class="text-center mt-4 font-body-sm text-outline flex items-center justify-center gap-1.5">
            <span class="material-symbols-outlined text-base">verified_user</span>
            Pago 100% seguro y encriptado
          </p>
        </div>

        <!-- Aviso política -->
        <div class="p-5 bg-amber-50/40 rounded-xl border border-amber-100/60">
          <div class="flex gap-3">
            <span class="material-symbols-outlined text-amber-600 shrink-0">info</span>
            <div>
              <p class="font-body-sm font-medium text-amber-900">Política de devolución</p>
              <p class="font-body-sm text-amber-800/70 mt-1">Los productos pueden devolverse dentro de 7 días desde la recepción en su empaque original.</p>
            </div>
          </div>
        </div>

        <%= link_to cart_path, class: "flex items-center gap-2 font-body-sm text-on-surface-variant hover:text-primary transition-colors" do %>
          <span class="material-symbols-outlined text-base">arrow_back</span>
          Volver al carrito
        <% end %>

      </aside>

    </div><!-- /grid -->
  <% end %>

</main>

<%# Utility CSS classes — only applied once via Tailwind's @apply would need a CSS file.
    We define inline via a style block for the field pattern used throughout. %>
<style>
  .field-underline {
    @apply relative border-b border-outline focus-within:border-primary transition-colors pb-1;
  }
  .field-label {
    @apply block text-xs font-semibold tracking-widest uppercase text-on-surface-variant mb-1;
  }
  .field-input {
    @apply w-full bg-transparent border-none p-0 focus:ring-0 text-base text-on-surface;
  }
</style>
