               "+40","+41","+43","+44","+45","+46","+47","+48","+49","+51","+52",
               "+53","+54","+55","+56","+57","+58","+60","+61","+62","+63","+64",
               "+65","+66","+81","+82","+84","+86","+90","+91","+92","+93","+94",
               "+95","+98","+212","+213","+216","+218","+220","+221","+222","+223",
