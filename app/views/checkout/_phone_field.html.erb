<%#
  Partial: phone field with searchable country code selector (Tom Select)
  Variables:
    f          - form builder
    field      - :billing_phone or :shipping_phone
    label_text - string label
    required   - true/false
    value      - current full phone value stored (e.g. "+56 9 1234 5678")
%>

<%
  field      ||= :billing_phone
  label_text ||= "Teléfono"
  required   ||= false

  stored           = value.to_s.strip
  uid              = "phone_#{field}_#{SecureRandom.hex(3)}"
  prefix_field     = :"#{field}_prefix"
  number_field     = :"#{field}_number"

  # Detect stored prefix to pre-select
