<%#
  Partial: phone field with custom country code picker
  Variables:
    f          - form builder
    field      - :billing_phone or :shipping_phone
    label_text - string
    required   - true/false
    value      - current stored value (e.g. "+56 9 1234 5678")
%>
<%
  field      ||= :billing_phone
  label_text ||= "Teléfono"
  required   ||= false

  stored  = value.to_s.strip
  # Detect stored prefix
  known   = ["+1809","+1868","+1876","+1","+7","+20","+27","+30","+31","+32",
             "+33","+34","+36","+39","+40","+41","+43","+44","+45","+46","+47",
             "+48","+49","+51","+52","+53","+54","+55","+56","+57","+58","+60",
             "+61","+62","+63","+64","+65","+66","+81","+82","+84","+86","+90",
             "+91","+92","+93","+94","+95","+98","+212","+213","+216","+218",
             "+221","+233","+234","+237","+244","+251","+254","+260","+263",
             "+267","+351","+352","+353","+354","+355","+356","+357","+358",
             "+359","+370","+371","+372","+373","+374","+375","+376","+377",
             "+380","+381","+382","+385","+386","+387","+389","+420","+421",
             "+423","+501","+502","+503","+504","+505","+506","+507","+509",
             "+591","+592","+593","+595","+597","+598","+673","+855","+856",
             "+880","+886","+960","+961","+962","+963","+964","+965","+966",
             "+967","+968","+970","+971","+972","+973","+974","+975","+976",
             "+977","+992","+993","+994","+995","+996","+998"]
  detected_prefix = known.sort_by { |c| -c.length }.find { |p| stored.start_with?(p) } || "+56"
  detected_number = stored.delete_prefix(detected_prefix).strip

  prefix_field = :"#{field}_prefix"
  number_field = :"#{field}_number"
%>

<div class="border-b border-stone-300 focus-within:border-stone-900 transition-colors pb-1">
  <label class="block text-[10px] font-semibold tracking-widest uppercase text-stone-400 mb-1">
    <%= label_text %><%= " *" if required %>
  </label>

  <div class="flex items-center gap-2">

    <%# ── Custom country picker ── %>
    <div class="relative shrink-0"
         data-controller="phone-country"
         data-phone-country-selected-value="<%= detected_prefix %>">

      <%# Hidden field that submits the prefix %>
      <input type="hidden"
             name="<%= "order[#{prefix_field}]" %>"
             data-phone-country-target="hidden"
             value="<%= detected_prefix %>">

      <%# Trigger button %>
      <button type="button"
              data-action="click->phone-country#toggle"
              data-phone-country-target="trigger"
              class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg
                     bg-stone-100 hover:bg-stone-200 transition-colors
                     border border-stone-200 hover:border-stone-300
                     focus:outline-none focus:ring-2 focus:ring-stone-400/30">
        <span data-phone-country-target="triggerFlag" class="text-lg leading-none">🇨🇱</span>
        <span data-phone-country-target="triggerCode" class="text-xs font-semibold text-stone-600 tabular-nums">+56</span>
        <span class="material-symbols-outlined text-[13px] text-stone-400">expand_more</span>
      </button>

      <%# Dropdown %>
      <div data-phone-country-target="dropdown"
           class="hidden absolute left-0 top-full mt-1 z-50 w-72
                  bg-white rounded-xl shadow-xl border border-stone-200
                  overflow-hidden"
           data-action="keydown->phone-country#onKeydown">

        <%# Search %>
        <div class="px-3 py-2.5 border-b border-stone-100">
          <div class="flex items-center gap-2 bg-stone-50 rounded-lg px-3 py-1.5">
            <span class="material-symbols-outlined text-[16px] text-stone-400">search</span>
            <input type="text"
                   data-phone-country-target="search"
                   data-action="input->phone-country#filter"
                   placeholder="Buscar país..."
                   class="flex-1 bg-transparent border-none p-0 text-sm focus:ring-0 text-stone-700">
          </div>
        </div>

        <%# Country list %>
        <div data-phone-country-target="list"
             class="overflow-y-auto max-h-56 py-1">
          <%# Populated by JS %>
        </div>
      </div>
    </div>

    <%# Phone number input %>
    <input type="tel"
           name="<%= "order[#{number_field}]" %>"
           value="<%= detected_number %>"
           placeholder="9 1234 5678"
           <%= "required" if required %>
           class="flex-1 bg-transparent border-none p-0 focus:ring-0 text-base min-w-0">
  </div>
</div>
