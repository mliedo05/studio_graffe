<h1 style="font-size:22px; font-weight:700; margin-bottom:6px;">Hola, <%= current_user.first_name %> 👋</h1>
<p style="font-size:14px; color:#9ca3af; margin-bottom:24px;">Este es tu resumen del mes de <%= Date.current.strftime("%B %Y").capitalize %></p>

<div class="sv-cards">
  <div class="sv-card" style="border-top:3px solid #C9A96E;">
    <div class="sv-card-label">💰 Mis comisiones</div>
    <div class="sv-card-value" style="color:#C9A96E;">
      <%= number_to_currency(@total_commission_cents , unit: "$", delimiter: ".", precision: 0) %>
    </div>
    <div class="sv-card-sub">este mes</div>
  </div>
  <div class="sv-card">
    <div class="sv-card-label">💇 Ventas generadas</div>
    <div class="sv-card-value">
      <%= number_to_currency(@total_sales_cents , unit: "$", delimiter: ".", precision: 0) %>
    </div>
    <div class="sv-card-sub">en servicios y productos</div>
  </div>
  <div class="sv-card">
    <div class="sv-card-label">📋 Items realizados</div>
    <div class="sv-card-value"><%= @items_count %></div>
    <div class="sv-card-sub">este mes</div>
  </div>
</div>

<!-- Gráfico histórico -->
<div class="chart-wrap" style="margin-bottom:24px;">
  <h3>Comisiones últimos 5 meses</h3>
  <canvas id="historyChart" height="100"></canvas>
</div>

<!-- Por servicio -->
<div class="sv-table-wrap">
  <div class="sv-table-head"><h3>Desglose por servicio este mes</h3></div>
  <table class="sv-table">
    <thead><tr><th>Servicio / Producto</th><th>Veces</th><th>Comisión total</th></tr></thead>
    <tbody>
      <% @by_service.each do |item| %>
        <tr>
          <td style="font-weight:500;"><%= item.description %></td>
          <td><%= item.count %></td>
          <td style="color:#C9A96E; font-weight:600;"><%= number_to_currency(item.total_commission_cents , unit: "$", delimiter: ".", precision: 0) %></td>
        </tr>
      <% end %>
      <% if @by_service.empty? %>
        <tr><td colspan="3" style="text-align:center; color:#9ca3af; padding:24px;">Sin registros este mes</td></tr>
      <% end %>
    </tbody>
  </table>
</div>

<div style="text-align:center; margin-top:16px;">
  <%= link_to "Ver historial completo →", stylist_panel_commissions_path, style: "font-size:13px; color:#C9A96E; text-decoration:none; font-weight:600;" %>
</div>

<script>
new Chart(document.getElementById('historyChart'), {
  type: 'bar',
  data: {
    labels: <%= raw @monthly_history.map { |m| m[:month] }.to_json %>,
    datasets: [{
      label: 'Comisión ($)',
      data: <%= raw @monthly_history.map { |m| m[:total_cents]  }.to_json %>,
      backgroundColor: 'rgba(201,169,110,0.7)',
      borderColor: '#C9A96E',
      borderWidth: 1, borderRadius: 4
    }]
  },
  options: {
    responsive: true,
    plugins: { legend: { display: false } },
    scales: { y: { ticks: { callback: v => '$' + v.toLocaleString('es-CL') } } }
  }
});
</script>
