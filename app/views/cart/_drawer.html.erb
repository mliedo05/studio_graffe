<%# Cart drawer — rendered in the layout, data-controller is on <body> in application.html.erb %>
<div>

  <!-- Backdrop -->
  <div data-cart-drawer-target="backdrop"
       data-action="click->cart-drawer#close"
       class="fixed inset-0 bg-black/40 z-40 hidden opacity-0 transition-opacity duration-300 backdrop-blur-sm"></div>

  <!-- Panel -->
  <aside data-cart-drawer-target="panel"
         class="fixed top-0 right-0 h-full w-full max-w-sm bg-white z-50
                translate-x-full transition-transform duration-300 ease-in-out
                flex flex-col shadow-2xl">

    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-5 border-b border-stone-100">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-stone-700">shopping_bag</span>
        <h2 class="font-semibold text-base text-stone-900">Tu carrito</h2>
        <span class="ml-1 px-2 py-0.5 bg-stone-100 text-stone-500 rounded-full text-xs font-bold"
              data-cart-drawer-target="count">0</span>
      </div>
      <button type="button" data-action="click->cart-drawer#close"
              class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-stone-100 transition-colors">
        <span class="material-symbols-outlined text-[18px] text-stone-500">close</span>
      </button>
    </div>

    <!-- Items list -->
    <div data-cart-drawer-target="items"
         class="flex-1 overflow-y-auto px-6 py-4 space-y-4">
      <!-- Populated by JS from cart data -->
    </div>

    <!-- Empty state (shown when no items) -->
    <div data-cart-drawer-target="emptyState"
         class="hidden flex-1 flex flex-col items-center justify-center gap-3 px-6 text-center">
      <span class="material-symbols-outlined text-stone-200 text-6xl">shopping_basket</span>
      <p class="font-semibold text-stone-400">Tu carrito está vacío</p>
      <p class="text-xs text-stone-400">Agrega productos para comenzar</p>
    </div>

    <!-- Footer -->
    <div data-cart-drawer-target="footer"
         class="border-t border-stone-100 px-6 py-5 space-y-4 hidden">

      <!-- Subtotal -->
      <div class="flex items-baseline justify-between">
        <span class="text-sm text-stone-500">Subtotal</span>
        <span class="font-bold text-lg text-stone-900" data-cart-drawer-target="subtotal">$0</span>
      </div>

      <!-- Suggested products hint -->
      <p class="text-xs text-stone-400 text-center">
        ¿Falta algo? Sigue explorando la tienda 🛍️
      </p>

      <!-- Actions -->
      <div class="space-y-2">
        <%= link_to checkout_path,
              class: "block w-full py-3.5 bg-stone-900 text-white rounded-xl text-sm font-semibold
                      text-center tracking-wide hover:bg-stone-700 active:scale-[0.98] transition-all",
              data: { turbo_frame: "_top" } do %>
          Finalizar compra →
        <% end %>
        <%= link_to cart_path,
              class: "block w-full py-3 border border-stone-200 text-stone-600 rounded-xl text-sm
                      font-medium text-center hover:bg-stone-50 transition-colors",
              data: { action: "click->cart-drawer#close", turbo_frame: "_top" } do %>
          Ver carrito completo
        <% end %>
      </div>
    </div>

  </aside>
</div>

<%# Hidden JSON data island — keeps the JS in sync with server-side cart data %>
<% if user_signed_in? && (cart = current_user.current_cart) %>
  <script id="cart-drawer-data" type="application/json">
    {
      "count": <%= cart.item_count %>,
      "subtotal": "<%= humanized_money_with_symbol(cart.subtotal) %>",
      "items": [
        <% cart.order_items.includes(:product).each_with_index do |item, i| %>
          {
            "id": <%= item.id %>,
            "name": <%= item.product.name.to_json %>,
            "quantity": <%= item.quantity %>,
            "unit_price": "<%= humanized_money_with_symbol(item.unit_price) %>",
            "total_price": "<%= humanized_money_with_symbol(item.total_price) %>",
            "image_url": "<%= item.product.image.attached? ? url_for(item.product.image) : "" %>"
          }<%= i < cart.order_items.size - 1 ? "," : "" %>
        <% end %>
      ]
    }
  </script>
<% else %>
  <script id="cart-drawer-data" type="application/json">
    { "count": 0, "subtotal": "$0", "items": [] }
  </script>
<% end %>
