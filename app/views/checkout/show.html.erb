<% content_for :title, "Finalizar Compra — Studio Graffé" %>

<style>
  .field-wrap  { @apply relative border-b border-outline focus-within:border-primary transition-colors pb-1; }
  .field-label { @apply block text-[10px] font-semibold tracking-widest uppercase text-on-surface-variant mb-1; }
  .field-input { @apply w-full bg-transparent border-none p-0 focus:ring-0 text-base text-on-surface; }

  /* Step indicator states */
  [data-state="done"]    .step-circle { @apply bg-primary text-on-primary; }
  [data-state="active"]  .step-circle { @apply bg-primary text-on-primary ring-4 ring-primary/20; }
  [data-state="pending"] .step-circle { @apply bg-surface-container text-on-surface-variant; }
  [data-state="done"]    .step-label  { @apply text-primary font-medium; }
  [data-state="active"]  .step-label  { @apply text-on-surface font-semibold; }
  [data-state="pending"] .step-label  { @apply text-on-surface-variant; }
  [data-state="done"]    .step-line   { @apply bg-primary; }
</style>

<main class="pt-28 pb-20 px-4 sm:px-8 max-w-screen-lg mx-auto"
      data-controller="checkout">

  <%= form_with model: @order,
        url: checkout_payment_path,
        method: :post,
        local: true do |f| %>

    <!-- ══════════════════════════════════════════════════
         STEP INDICATOR BAR
    ══════════════════════════════════════════════════ -->
    <nav class="flex items-center justify-center gap-0 mb-12 select-none">

      <% [
        { label: "Facturación",   icon: "receipt_long" },
        { label: "Envío",         icon: "local_shipping" },
        { label: "Confirmar",     icon: "check_circle" }
      ].each_with_index do |s, i| %>

        <button type="button"
                data-checkout-target="stepIndicator"
                data-state="<%= i == 0 ? 'active' : 'pending' %>"
                data-step="<%= i %>"
                data-action="click->checkout#goToStep"
                class="flex flex-col items-center gap-1.5 cursor-pointer group">
          <span class="step-circle w-10 h-10 rounded-full flex items-center justify-center transition-all duration-200">
            <span class="material-symbols-outlined text-[20px]"><%= s[:icon] %></span>
          </span>
          <span class="step-label text-xs transition-all duration-200 hidden sm:block"><%= s[:label] %></span>
        </button>

        <% unless i == 2 %>
          <div class="step-line h-0.5 w-16 sm:w-24 bg-outline-variant mx-1 transition-colors duration-300"></div>
        <% end %>

      <% end %>
    </nav>


    <!-- ══════════════════════════════════════════════════
         PASO 1 — FACTURACIÓN
    ══════════════════════════════════════════════════ -->
    <div data-checkout-target="step">
      <div class="max-w-lg mx-auto">
        <div class="mb-8">
          <h1 class="text-2xl font-bold text-on-surface">Datos de Facturación</h1>
          <p class="text-sm text-on-surface-variant mt-1">Esta información aparecerá en tu boleta.</p>
        </div>

        <div class="space-y-6">

          <!-- Nombre + Apellido -->
          <div class="grid grid-cols-2 gap-4">
            <div class="field-wrap">
              <%= f.label :billing_first_name, "Nombre", class: "field-label" %>
              <%= f.text_field :billing_first_name,
                    required: true, autocomplete: "given-name",
                    placeholder: "Ej: María", class: "field-input" %>
            </div>
            <div class="field-wrap">
              <%= f.label :billing_last_name, "Apellido", class: "field-label" %>
              <%= f.text_field :billing_last_name,
                    required: true, autocomplete: "family-name",
                    placeholder: "Ej: González", class: "field-input" %>
            </div>
          </div>

          <!-- Tipo + Número de documento -->
          <div class="grid grid-cols-2 gap-4">
            <div class="field-wrap">
              <%= f.label :billing_document_type, "Tipo de documento", class: "field-label" %>
              <%= f.select :billing_document_type,
                    [["RUT", "rut"], ["Pasaporte", "passport"], ["DNI", "dni"]],
                    { selected: @order.billing_document_type || "rut" },
                    required: true,
                    class: "field-input bg-transparent cursor-pointer",
                    data: { action: "change->checkout#documentTypeChanged" } %>
            </div>
            <div class="field-wrap">
              <%= f.label :billing_document_number, "Número", class: "field-label" %>
              <%= f.text_field :billing_document_number,
                    required: true,
                    placeholder: "Ej: 12.345.678-9",
                    class: "field-input",
                    data: { checkout_target: "documentNumber" } %>
            </div>
          </div>

          <!-- Email -->
          <div class="field-wrap">
            <%= f.label :billing_email, "Correo electrónico", class: "field-label" %>
            <%= f.email_field :billing_email,
                  required: true, autocomplete: "email",
                  placeholder: "tu@correo.com", class: "field-input" %>
          </div>

          <!-- Teléfono -->
          <div class="field-wrap">
            <%= f.label :billing_phone, "Teléfono", class: "field-label" %>
            <div class="flex items-end gap-2">
              <span class="text-on-surface-variant text-base pb-0.5 shrink-0 select-none">+56</span>
              <%= f.telephone_field :billing_phone,
                    required: true, autocomplete: "tel-national",
                    placeholder: "9 1234 5678", class: "field-input flex-1" %>
            </div>
          </div>

        </div>

        <!-- Siguiente -->
        <div class="mt-10">
          <button type="button"
                  data-action="click->checkout#next"
                  class="w-full bg-primary text-on-primary py-4 rounded-xl font-semibold
                         tracking-wide hover:bg-stone-800 active:scale-[0.98] transition-all">
            Continuar con Envío →
          </button>
        </div>
      </div>
    </div><!-- /paso 1 -->


    <!-- ══════════════════════════════════════════════════
         PASO 2 — ENVÍO
    ══════════════════════════════════════════════════ -->
    <div data-checkout-target="step" class="hidden">
      <div class="max-w-lg mx-auto">
        <div class="mb-8">
          <h1 class="text-2xl font-bold text-on-surface">Tipo de Envío</h1>
          <p class="text-sm text-on-surface-variant mt-1">¿Cómo quieres recibir tu pedido?</p>
        </div>

        <!-- Opciones de envío -->
        <div class="grid grid-cols-2 gap-4 mb-6">

          <label class="flex flex-col items-center gap-3 p-5 border-2 border-outline-variant rounded-2xl
                        cursor-pointer hover:border-primary/40 transition-colors text-center
                        has-[:checked]:border-primary has-[:checked]:bg-primary/5">
            <%= f.radio_button :shipping_type, "pickup",
                  checked: (@order.shipping_type.blank? || @order.shipping_type == "pickup"),
                  class: "sr-only",
                  data: { action: "change->checkout#shippingTypeChanged" } %>
            <span class="material-symbols-outlined text-3xl text-primary">storefront</span>
            <div>
              <p class="font-semibold text-sm text-on-surface">Retiro en tienda</p>
              <p class="text-xs text-on-surface-variant mt-0.5">Gratis · 2–3 días hábiles</p>
            </div>
          </label>

          <label class="flex flex-col items-center gap-3 p-5 border-2 border-outline-variant rounded-2xl
                        cursor-pointer hover:border-primary/40 transition-colors text-center
                        has-[:checked]:border-primary has-[:checked]:bg-primary/5">
            <%= f.radio_button :shipping_type, "delivery",
                  checked: @order.shipping_type == "delivery",
                  class: "sr-only",
                  data: { action: "change->checkout#shippingTypeChanged" } %>
            <span class="material-symbols-outlined text-3xl text-primary">local_shipping</span>
            <div>
              <p class="font-semibold text-sm text-on-surface">Delivery</p>
              <p class="text-xs text-on-surface-variant mt-0.5">Envío a domicilio</p>
            </div>
          </label>

        </div>

        <!-- Formulario de dirección (solo delivery) -->
        <div data-checkout-target="shippingSection"
             class="<%= @order.shipping_type == 'delivery' ? '' : 'hidden' %> space-y-5">

          <div class="border-t border-outline-variant pt-5">
            <p class="text-xs font-semibold tracking-widest uppercase text-on-surface-variant mb-5">Dirección de entrega</p>

            <!-- Destinatario + Teléfono -->
            <div class="grid grid-cols-2 gap-4 mb-5">
              <div class="field-wrap">
                <%= f.label :shipping_recipient_name, "Nombre destinatario", class: "field-label" %>
                <%= f.text_field :shipping_recipient_name,
                      autocomplete: "name", placeholder: "Quien recibe",
                      class: "field-input" %>
              </div>
              <div class="field-wrap">
                <%= f.label :shipping_phone, "Teléfono", class: "field-label" %>
                <div class="flex items-end gap-1.5">
                  <span class="text-on-surface-variant text-sm pb-0.5 shrink-0">+56</span>
                  <%= f.telephone_field :shipping_phone,
                        placeholder: "9 1234 5678", class: "field-input flex-1" %>
                </div>
              </div>
            </div>

            <!-- Región + Comuna -->
            <div class="grid grid-cols-2 gap-4 mb-5">
              <div class="field-wrap">
                <%= f.label :shipping_region, "Región", class: "field-label" %>
                <%= f.select :shipping_region,
                      [["— Región —", ""]] + Address::REGIONS.keys.map { |r| [r, r] },
                      {},
                      class: "field-input bg-transparent cursor-pointer",
                      data: {
                        action: "change->checkout#regionChanged",
                        checkout_target: "regionSelect"
                      } %>
              </div>
              <div class="field-wrap">
                <%= f.label :shipping_comuna, "Comuna", class: "field-label" %>
                <select name="order[shipping_comuna]"
                        id="order_shipping_comuna"
                        class="field-input bg-transparent cursor-pointer"
                        data-checkout-target="comunaSelect"
                        data-selected="<%= @order.shipping_comuna %>">
                  <option value="">— Comuna —</option>
                  <% if @order.shipping_region.present? %>
                    <% Address::REGIONS[@order.shipping_region]&.each do |c| %>
                      <option value="<%= c %>" <%= "selected" if @order.shipping_comuna == c %>><%= c %></option>
                    <% end %>
                  <% end %>
                </select>
              </div>
            </div>

            <!-- Ciudad -->
            <div class="field-wrap mb-5">
              <%= f.label :shipping_city, "Ciudad", class: "field-label" %>
              <%= f.text_field :shipping_city,
                    autocomplete: "address-level2",
                    placeholder: "Ej: Santiago", class: "field-input" %>
            </div>

            <!-- Calle + Número -->
            <div class="grid grid-cols-2 gap-4 mb-5">
              <div class="field-wrap">
                <%= f.label :shipping_street, "Calle", class: "field-label" %>
                <%= f.text_field :shipping_street,
                      placeholder: "Ej: Av. Providencia", class: "field-input" %>
              </div>
              <div class="field-wrap">
                <%= f.label :shipping_street_number, "Número", class: "field-label" %>
                <%= f.text_field :shipping_street_number,
                      placeholder: "Ej: 1234", class: "field-input" %>
              </div>
            </div>

            <!-- Toggle departamento -->
            <label class="flex items-center gap-2.5 cursor-pointer select-none mb-3 w-fit">
              <input type="checkbox"
                     class="accent-primary w-4 h-4 rounded"
                     <%= "checked" if @order.shipping_apartment.present? %>
                     data-action="change->checkout#toggleApartment">
              <span class="text-sm text-on-surface-variant">¿Tiene número de departamento o piso?</span>
            </label>

            <div data-checkout-target="apartmentWrapper"
                 class="<%= @order.shipping_apartment.present? ? '' : 'hidden' %> field-wrap">
              <%= f.label :shipping_apartment, "Departamento / Piso", class: "field-label" %>
              <%= f.text_field :shipping_apartment,
                    placeholder: "Ej: Depto 4B, Piso 3",
                    class: "field-input",
                    data: { checkout_target: "apartmentField" } %>
            </div>

          </div>
        </div><!-- /address section -->

        <!-- Navegación -->
        <div class="mt-10 flex gap-3">
          <button type="button"
                  data-action="click->checkout#back"
                  class="flex-1 border border-outline-variant text-on-surface py-4 rounded-xl
                         font-semibold hover:bg-surface-container transition-all">
            ← Volver
          </button>
          <button type="button"
                  data-action="click->checkout#next"
                  class="flex-[2] bg-primary text-on-primary py-4 rounded-xl font-semibold
                         tracking-wide hover:bg-stone-800 active:scale-[0.98] transition-all">
            Continuar con Pago →
          </button>
        </div>
      </div>
    </div><!-- /paso 2 -->


    <!-- ══════════════════════════════════════════════════
         PASO 3 — CONFIRMAR PEDIDO
    ══════════════════════════════════════════════════ -->
    <div data-checkout-target="step" class="hidden">
      <div class="max-w-2xl mx-auto">
        <div class="mb-8">
          <h1 class="text-2xl font-bold text-on-surface">Confirmar Pedido</h1>
          <p class="text-sm text-on-surface-variant mt-1">Revisa tu información antes de pagar.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">

          <!-- Resumen facturación -->
          <div class="bg-surface-container-low rounded-2xl p-5 border border-outline-variant/50">
            <div class="flex items-center justify-between mb-4">
              <p class="text-xs font-bold tracking-widest uppercase text-on-surface-variant">Facturación</p>
              <button type="button" data-action="click->checkout#back"
                      onclick="this.closest('[data-controller]').__checkoutController?.goBack(0)"
                      data-step="0"
                      data-action="click->checkout#goToStep"
                      class="text-xs text-primary hover:underline">Editar</button>
            </div>
            <div class="space-y-1.5 text-sm">
              <p><span class="text-on-surface-variant">Nombre: </span>
                 <span class="font-medium" data-checkout-target="summaryFirstName">—</span></p>
              <p><span class="text-on-surface-variant">Documento: </span>
                 <span class="font-medium" data-checkout-target="summaryDocument">—</span></p>
              <p><span class="text-on-surface-variant">Email: </span>
                 <span class="font-medium" data-checkout-target="summaryEmail">—</span></p>
              <p><span class="text-on-surface-variant">Teléfono: </span>
                 <span class="font-medium" data-checkout-target="summaryPhone">—</span></p>
            </div>
          </div>

          <!-- Resumen envío -->
          <div class="bg-surface-container-low rounded-2xl p-5 border border-outline-variant/50">
            <div class="flex items-center justify-between mb-4">
              <p class="text-xs font-bold tracking-widest uppercase text-on-surface-variant">Envío</p>
              <button type="button"
                      data-step="1"
                      data-action="click->checkout#goToStep"
                      class="text-xs text-primary hover:underline">Editar</button>
            </div>
            <div class="space-y-1.5 text-sm">
              <p><span class="text-on-surface-variant">Tipo: </span>
                 <span class="font-medium" data-checkout-target="summaryShipping">—</span></p>
              <div data-checkout-target="summaryAddress">
                <p class="text-on-surface-variant mt-1 text-xs leading-relaxed"
                   data-checkout-target="summaryAddress"></p>
              </div>
            </div>
          </div>

        </div>

        <!-- Productos del pedido -->
        <div class="bg-white border border-stone-100 rounded-2xl p-6 mb-6 shadow-sm">
          <h3 class="font-semibold text-on-surface mb-5">Productos</h3>

          <div class="space-y-4 max-h-64 overflow-y-auto pr-1">
            <% @cart.order_items.includes(:product).each do |item| %>
              <div class="flex gap-4 items-center">
                <div class="w-14 h-14 bg-stone-100 rounded-xl overflow-hidden shrink-0">
                  <% if item.product.image.attached? %>
                    <%= image_tag item.product.image, alt: item.product.name, class: "w-full h-full object-cover" %>
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center">
                      <span class="material-symbols-outlined text-stone-300">inventory_2</span>
                    </div>
                  <% end %>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium truncate"><%= item.product.name %></p>
                  <p class="text-xs text-on-surface-variant">Cantidad: <%= item.quantity %></p>
                </div>
                <p class="text-sm font-semibold shrink-0">
                  <%= humanized_money_with_symbol(item.total_price) %>
                </p>
              </div>
            <% end %>
          </div>

          <div class="border-t border-stone-100 mt-5 pt-4 space-y-2">
            <div class="flex justify-between text-sm text-on-surface-variant">
              <span>Subtotal</span>
              <span><%= humanized_money_with_symbol(@cart.subtotal) %></span>
            </div>
            <div class="flex justify-between text-sm text-on-surface-variant">
              <span>Envío</span>
              <span class="text-primary text-xs font-medium">Por confirmar</span>
            </div>
            <div class="flex justify-between pt-3 border-t border-stone-100">
              <span class="text-lg font-bold">Total</span>
              <span class="text-lg font-bold"><%= humanized_money_with_symbol(@cart.total) %></span>
            </div>
          </div>
        </div>

        <!-- Método de pago -->
        <div class="bg-surface-container-low rounded-2xl p-5 border border-outline-variant/50 mb-8">
          <p class="text-xs font-bold tracking-widest uppercase text-on-surface-variant mb-4">Método de Pago</p>
          <div class="grid grid-cols-2 gap-3">

            <label class="flex items-center gap-3 p-4 border-2 border-outline-variant rounded-xl cursor-pointer
                          hover:border-primary/40 has-[:checked]:border-primary has-[:checked]:bg-primary/5 transition-colors">
              <input type="radio" name="payment_method" value="webpay" checked class="accent-primary">
              <div>
                <p class="text-sm font-semibold">Webpay Plus</p>
                <p class="text-xs text-on-surface-variant">Débito y crédito</p>
              </div>
            </label>

            <label class="flex items-center gap-3 p-4 border-2 border-outline-variant rounded-xl cursor-pointer
                          hover:border-primary/40 has-[:checked]:border-primary has-[:checked]:bg-primary/5 transition-colors">
              <input type="radio" name="payment_method" value="efectivo" class="accent-primary">
              <div>
                <p class="text-sm font-semibold">Efectivo</p>
                <p class="text-xs text-on-surface-variant">Al retirar o recibir</p>
              </div>
            </label>

          </div>
        </div>

        <!-- Navegación final -->
        <div class="flex gap-3">
          <button type="button"
                  data-step="1"
                  data-action="click->checkout#goToStep"
                  class="flex-1 border border-outline-variant text-on-surface py-4 rounded-xl
                         font-semibold hover:bg-surface-container transition-all">
            ← Volver
          </button>

          <%= f.submit "Confirmar y Pagar →",
                class: "flex-[2] bg-primary text-on-primary py-4 rounded-xl font-semibold
                        tracking-wide hover:bg-stone-800 active:scale-[0.98] transition-all cursor-pointer" %>
        </div>

        <p class="text-center mt-5 text-xs text-outline flex items-center justify-center gap-1.5">
          <span class="material-symbols-outlined text-sm">verified_user</span>
          Pago 100% seguro y encriptado
        </p>

      </div>
    </div><!-- /paso 3 -->

  <% end %>

</main>
