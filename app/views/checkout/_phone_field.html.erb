               "+234","+235","+236","+237","+238","+239","+240","+241","+242","+243",
               "+244","+245","+246","+247","+248","+249","+250","+251","+252","+253",
               "+254","+255","+256","+257","+258","+260","+261","+262","+263","+264",
               "+265","+266","+267","+268","+269","+290","+291","+297","+298","+299",
               "+350","+351","+352","+353","+354","+355","+356","+357","+358","+359",
               "+370","+371","+372","+373","+374","+375","+376","+377","+378","+380",
               "+381","+382","+385","+386","+387","+389","+420","+421","+423","+500",
               "+501","+502","+503","+504","+505","+506","+507","+508","+509","+590",
               "+591","+592","+593","+594","+595","+596","+597","+598","+599","+670",
               "+672","+673","+674","+675","+676","+677","+678","+679","+680","+681",
               "+682","+683","+685","+686","+687","+688","+689","+690","+691","+692",
               "+850","+852","+853","+855","+856","+880","+886","+960","+961","+962",
               "+963","+964","+965","+966","+967","+968","+970","+971","+972","+973",
               "+974","+975","+976","+977","+992","+993","+994","+995","+996","+998"]
  detected_prefix = all_codes.sort_by { |c| -c.length }.find { |p| stored.start_with?(p) } || "+56"
  detected_number = stored.delete_prefix(detected_prefix).strip
%>

<div class="border-b border-stone-300 focus-within:border-stone-900 transition-colors pb-1">
  <label class="block text-[10px] font-semibold tracking-widest uppercase text-stone-400 mb-1">
    <%= label_text %><%= " *" if required %>
  </label>
  <div class="flex items-center gap-2">

    <%# Searchable country code select %>
    <select id="<%= uid %>"
            name="<%= "order[#{prefix_field}]" %>"
            class="ts-country-phone shrink-0"
            style="width: 180px">
    </select>

    <%# Local number input %>
    <input type="tel"
           name="<%= "order[#{number_field}]" %>"
           value="<%= detected_number %>"
           placeholder="Número local"
           <%= "required" if required %>
           class="flex-1 bg-transparent border-none p-0 focus:ring-0 text-base min-w-0">

  </div>
</div>

