<!-- Selector de mes -->
<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px;">
  <div>
    <h1 style="font-size:20px; font-weight:700;">Mis comisiones</h1>
    <p style="font-size:13px; color:#9ca3af; margin-top:2px;"><%= @month.strftime("%B %Y").capitalize %></p>
  </div>
  <div style="display:flex; gap:8px; align-items:center;">
    <%= link_to "← Mes anterior", stylist_panel_commissions_path(month: (@month - 1.month).strftime("%Y-%m")), class: "btn btn-outline btn-sm" %>
    <% if @month < Date.current.beginning_of_month %>
      <%= link_to "Mes siguiente →", stylist_panel_commissions_path(month: (@month + 1.month).strftime("%Y-%m")), class: "btn btn-outline btn-sm" %>
    <% end %>
  </div>
</div>

<!-- Totales del mes -->
<div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:24px;">
  <div class="sv-card" style="border-top:3px solid #C9A96E;">
    <div class="sv-card-label">💰 Comisiones del mes</div>
    <div class="sv-card-value" style="color:#C9A96E;">
      <%= number_to_currency(@total_commission_cents , unit: "$", delimiter: ".", precision: 0) %>
    </div>
  </div>
  <div class="sv-card">
    <div class="sv-card-label">💇 Ventas generadas</div>
    <div class="sv-card-value">
      <%= number_to_currency(@total_sales_cents , unit: "$", delimiter: ".", precision: 0) %>
    </div>
    <div class="sv-card-sub"><%= @pagy.count %> items registrados</div>
  </div>
</div>

<!-- Detalle -->
<div class="sv-table-wrap">
  <div class="sv-table-head"><h3>Detalle de comisiones</h3></div>
  <table class="sv-table">
    <thead>
      <tr><th>Fecha</th><th>N° Atención</th><th>Descripción</th><th>Tipo</th><th>Precio</th><th>%</th><th>Comisión</th></tr>
    </thead>
    <tbody>
      <% @items.each do |item| %>
        <tr>
          <td><%= item.attendance.attended_on.strftime("%d/%m/%Y") %></td>
          <td><code style="font-size:12px;"><%= item.attendance.number %></code></td>
          <td style="font-weight:500;"><%= item.description %></td>
          <td>
            <span class="badge <%= item.service? ? "badge-yellow" : "badge-blue" %>">
              <%= item.service? ? "Servicio" : "Producto" %>
            </span>
          </td>
          <td><%= number_to_currency(item.price_cents , unit: "$", delimiter: ".", precision: 0) %></td>
          <td><%= item.commission_percent %>%</td>
          <td style="color:#C9A96E; font-weight:700;">
            <%= number_to_currency(item.commission_cents , unit: "$", delimiter: ".", precision: 0) %>
          </td>
        </tr>
      <% end %>
      <% if @items.empty? %>
        <tr><td colspan="7" style="text-align:center; color:#9ca3af; padding:32px;">Sin registros en <%= @month.strftime("%B %Y").capitalize %></td></tr>
      <% end %>
    </tbody>
  </table>
  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
