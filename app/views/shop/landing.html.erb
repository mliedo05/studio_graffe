<% content_for :title, "Studio Graffé — Belleza con intención" %>

<% content_for :head do %>
<style>
  /* ── Hero 3D: recorrido por el salón en line art ── */
  .salon-hero { height: 400vh; position: relative; background: #EDE4D5; }
  .salon-hero__stage { position: sticky; top: 0; height: 100vh; overflow: hidden; display: flex; align-items: center; }
  .salon-hero__canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .salon-hero__intro { position: relative; z-index: 2; width: 100%; max-width: 72rem; margin: 0 auto; padding: 0 1.5rem; }
  .salon-hero__intro h1 { font-family: 'Noto Serif', serif; font-size: clamp(2.6rem, 7vw, 5.6rem); line-height: 1.03; letter-spacing: -0.02em; color: #2B241C; max-width: 46rem; margin-bottom: 1.5rem; text-shadow: 0 0 24px #EDE4D5, 0 0 10px #EDE4D5; }
  .salon-hero__intro h1 em, .salon-hero__step h2 em { color: #8B7355; }
  .salon-hero__intro p { font-family: 'Inter', sans-serif; max-width: 28rem; color: #5C4B39; font-size: 1.05rem; line-height: 1.7; margin-bottom: 2.25rem; text-shadow: 0 0 12px #EDE4D5, 0 0 6px #EDE4D5; }
  .salon-hero__step { position: absolute; inset: 0; z-index: 2; display: flex; align-items: center; justify-content: center; text-align: center; padding: 0 1.5rem; pointer-events: none; opacity: 0; }
  .salon-hero__step--low { align-items: flex-end; padding-bottom: 14vh; }
  .salon-hero__step h2 { font-family: 'Noto Serif', serif; font-size: clamp(2.4rem, 7vw, 6rem); line-height: 1.05; color: #3E3226; text-shadow: 0 0 30px #EDE4D5, 0 0 12px #EDE4D5; }
  .salon-hero__step p { font-family: 'Inter', sans-serif; margin-top: 1rem; font-size: 12px; letter-spacing: .35em; text-transform: uppercase; color: #5C4B39; text-shadow: 0 0 12px #EDE4D5, 0 0 6px #EDE4D5; }
  .salon-hero__step a { pointer-events: auto; }
  .salon-hero__progress { position: absolute; right: 1.75rem; top: 50%; transform: translateY(-50%); z-index: 3; display: flex; flex-direction: column; gap: 10px; }
  .salon-hero__progress i { width: 2px; height: 28px; background: rgba(139,115,85,.25); display: block; transition: background .3s; }
  .salon-hero__progress i.on { background: #C9A96E; }
  .salon-hero__hint { position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%); z-index: 2; font-family: 'Inter', sans-serif; font-size: 10px; letter-spacing: .3em; text-transform: uppercase; color: #8B7355; transition: opacity .4s; }
  /* Sin WebGL: portada fija con el texto principal */
  .salon-hero.is-static { height: auto; }
  .salon-hero.is-static .salon-hero__stage { position: relative; min-height: 100vh; }
  .salon-hero.is-static .salon-hero__step, .salon-hero.is-static .salon-hero__progress { display: none; }
  @media (max-width: 760px) { .salon-hero__progress { display: none; } }
  .service-card:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.08); }
  .product-card:hover { transform: translateY(-3px); }
  .ig-card:hover .ig-overlay { opacity: 1; }
  .ig-overlay { transition: opacity 0.3s ease; }
  .scroll-snap { scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; }
  .scroll-snap > * { scroll-snap-align: start; }
  @keyframes fadeInUp { from { opacity:0; transform:translateY(24px); } to { opacity:1; transform:translateY(0); } }
  .fade-in { animation: fadeInUp 0.7s ease both; }
  .fade-in-2 { animation: fadeInUp 0.7s 0.15s ease both; }
  .fade-in-3 { animation: fadeInUp 0.7s 0.3s ease both; }
</style>
<% end %>

<!-- ═══════════════════════════════════════════════
     HERO — Recorrido 3D por el salón (line art)
     El scroll mueve la cámara; salon_hero_controller carga Three.js solo aquí.
════════════════════════════════════════════════ -->
<section class="salon-hero" data-controller="salon-hero" aria-label="Recorrido por Studio Graffé">
  <div class="salon-hero__stage">
    <canvas class="salon-hero__canvas" data-salon-hero-target="canvas" aria-hidden="true"></canvas>

    <div class="salon-hero__intro" data-salon-hero-target="step">
      <p class="font-label-caps text-[11px] tracking-[0.25em] uppercase mb-6" style="color:#8B7355; text-shadow:none; margin-bottom:1.5rem;">Salón boutique · Santiago</p>
      <h1>El arte del <em>color,</em><br>hecho a tu medida</h1>
      <p>Un espacio donde cada detalle importa y cada clienta es única.</p>
      <div class="flex flex-col sm:flex-row gap-4">
        <%= link_to new_appointment_path, class: "px-10 py-4 font-label-caps text-[11px] tracking-[0.2em] uppercase transition-all duration-300 hover:scale-105 text-center", style: "background:#C9A96E; color:#fff; border-radius:2px;" do %>
          Reservar Cita
        <% end %>
        <%= link_to shop_path, class: "px-10 py-4 font-label-caps text-[11px] tracking-[0.2em] uppercase transition-all duration-300 hover:scale-105 text-center border", style: "border-color:#8B7355; color:#5C4B39; border-radius:2px; background:rgba(237,228,213,.6);" do %>
          Ver Productos
        <% end %>
      </div>
    </div>

    <div class="salon-hero__step salon-hero__step--low" data-salon-hero-target="step">
      <div><h2>Bienvenida a <em>Graffé</em></h2><p>Studio Graffé · Santiago</p></div>
    </div>
    <div class="salon-hero__step" data-salon-hero-target="step">
      <div><h2>Tu espejo,<br><em>tu momento</em></h2><p>Estaciones con luz natural y vista a la ciudad</p></div>
    </div>
    <div class="salon-hero__step" data-salon-hero-target="step">
      <div>
        <h2>Relájate,<br><em>nosotras nos encargamos</em></h2>
        <p style="margin-bottom:2rem;">Lavado, color y cuidado de principio a fin</p>
        <%= link_to new_appointment_path, class: "px-10 py-4 font-label-caps text-[11px] tracking-[0.2em] uppercase transition-all duration-300 hover:scale-105 inline-block", style: "background:#C9A96E; color:#fff; border-radius:2px;" do %>
          Reservar Cita
        <% end %>
      </div>
    </div>

    <div class="salon-hero__progress" aria-hidden="true">
      <i class="on" data-salon-hero-target="bar"></i><i data-salon-hero-target="bar"></i><i data-salon-hero-target="bar"></i><i data-salon-hero-target="bar"></i>
    </div>
    <div class="salon-hero__hint" data-salon-hero-target="hint">Desliza para entrar ↓</div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     SOBRE NOSOTRAS
════════════════════════════════════════════════ -->
<section class="py-32 px-6 bg-[#FAFAF8]">
  <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
    <!-- Texto -->
    <div>
      <p class="font-label-caps text-[11px] tracking-[0.25em] uppercase mb-6" style="color:#C9A96E;">Nuestra historia</p>
      <h2 class="mb-8" style="font-family:'Noto Serif',serif; font-size:2.5rem; line-height:1.2; color:#1A1A1A;">
        Donde el arte<br>y el cuidado<br>se encuentran.
      </h2>
      <p class="text-stone-500 text-lg leading-relaxed mb-8" style="font-family:'Inter',sans-serif;">
        Studio Graffé nace del amor por el detalle y la transformación. Somos un espacio donde cada clienta es única, cada servicio es un ritual y cada visita deja una huella.
      </p>
      <div class="flex flex-wrap gap-3">
        <% ["Confianza", "Creatividad", "Cuidado", "Exclusividad"].each do |valor| %>
          <span class="px-4 py-2 border text-xs font-medium tracking-wider uppercase"
                style="border-color:#C9A96E; color:#C9A96E; font-family:'Inter',sans-serif; letter-spacing:0.1em;">
            <%= valor %>
          </span>
        <% end %>
      </div>
    </div>
    <!-- Arco con insignia giratoria y foto superpuesta -->
    <div class="gx-about" data-gx-parallax>
      <div class="gx-about__arch">
        <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=900&q=80"
             alt="Equipo Studio Graffé" loading="lazy">
      </div>
      <svg class="gx-about__badge" viewBox="0 0 120 120" aria-hidden="true">
        <defs><path id="gx-circle" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"/></defs>
        <text><textPath href="#gx-circle">STUDIO GRAFFÉ · BELLEZA · RITUAL ·</textPath></text>
      </svg>
      <div class="gx-about__polaroid" data-gx-speed="0.12">
        <img src="https://images.unsplash.com/photo-1560066984-138dadb4c035?w=500&q=80"
             alt="Salón Studio Graffé" loading="lazy">
      </div>
    </div>
  </div>
</section>

<!-- Franja de servicios en movimiento -->
<div class="gx-marquee" aria-hidden="true">
  <div class="gx-marquee__track">
    <% 2.times do %>
      <% %w[Corte Color Balayage Faciales Peinados Tratamientos Manicure].each do |w| %>
        <span><%= w %></span><i>✦</i>
      <% end %>
    <% end %>
  </div>
</div>

<style>
  .gx-about{position:relative;padding:0 0 3rem 2.5rem}
  .gx-about__arch{aspect-ratio:4/5;border-radius:999px 999px 0 0;overflow:hidden;background:#B98A82}
  .gx-about__arch img{width:100%;height:100%;object-fit:cover;transform:scale(1.08);transition:transform 1.6s cubic-bezier(.2,.8,.2,1)}
  .gx-about:hover .gx-about__arch img{transform:scale(1.02)}
  .gx-about__badge{position:absolute;top:2%;right:-4%;width:120px;height:120px;animation:gx-spin 18s linear infinite}
  .gx-about__badge text{font-family:'Inter',sans-serif;font-size:9.5px;letter-spacing:.32em;fill:#8A7A68}
  .gx-about__polaroid{position:absolute;left:0;bottom:0;width:38%;padding:8px;background:#fff;box-shadow:0 18px 40px rgba(40,28,18,.18);will-change:transform}
  .gx-about__polaroid img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover}
  @keyframes gx-spin{to{transform:rotate(360deg)}}

  .gx-marquee{background:#17120E;color:#F4EEE6;overflow:hidden;padding:1.4rem 0}
  .gx-marquee__track{display:flex;width:max-content;align-items:center;gap:2.2rem;animation:gx-marquee 28s linear infinite}
  .gx-marquee span{font-family:'Noto Serif',serif;font-style:italic;font-size:clamp(1.4rem,3vw,2rem)}
  .gx-marquee i{font-style:normal;color:#C9A96E}
  @keyframes gx-marquee{to{transform:translateX(-50%)}}
  @media (max-width:640px){.gx-about{padding-left:1.25rem}.gx-about__badge{width:90px;height:90px;right:0}}
  @media (prefers-reduced-motion:reduce){.gx-about__badge,.gx-marquee__track{animation:none}}
</style>

<!-- ═══════════════════════════════════════════════
     SERVICIOS DESTACADOS
════════════════════════════════════════════════ -->
<section class="gx-services" style="background:#F5F3F0;">
  <div class="gx-services__inner">
    <div class="gx-services__aside gx-reveal">
      <p class="font-label-caps text-[11px] tracking-[0.25em] uppercase mb-4" style="color:#C9A96E;">Lo que ofrecemos</p>
      <h2 class="gx-h2">Nuestros <em>servicios</em></h2>
      <p class="gx-services__lead">Cada visita empieza con una conversación. Elige tu servicio y reserva con la estilista que prefieras.</p>
      <div class="gx-services__photo">
        <img src="https://images.unsplash.com/photo-1521590832167-7bcbfaa6381f?w=700&q=80" alt="Interior de Studio Graffé" loading="lazy">
      </div>
    </div>
    <div class="gx-services__main">
    <div class="gx-services__list">
      <% @featured_services.each_with_index do |service, i| %>
        <%= link_to new_appointment_path, class: "gx-row gx-reveal", style: "transition-delay:#{(i % 4) * 0.08}s" do %>
          <span class="gx-row__num"><%= format("%02d", i + 1) %></span>
          <span class="gx-row__title"><%= service.name %></span>
          <span class="gx-row__meta">
            <small><%= service.duration_minutes %> MIN</small>
            <b>desde <%= number_to_currency(service.price_cents, unit: "$", separator: ",", delimiter: ".", precision: 0) %></b>
          </span>
          <span class="gx-row__arrow" aria-hidden="true">→</span>
        <% end %>
      <% end %>
    </div>

    <%= link_to new_appointment_path, class: "gx-all" do %>Ver todos los servicios <span>→</span><% end %>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     CARRUSEL PRODUCTOS DESTACADOS
════════════════════════════════════════════════ -->
<% if @featured_products.any? %>
<section class="gx-prod" data-gx-carousel>
  <div class="gx-prod__head">
    <div>
      <p class="font-label-caps text-[11px] tracking-[0.25em] uppercase mb-3" style="color:#C9A96E;">Nuestra selección</p>
      <h2 class="gx-h2">Lo que usamos,<br><em>lo que vendemos.</em></h2>
    </div>
  </div>

  <div class="gx-prod__viewport" data-gx-viewport>
    <div class="gx-prod__track" data-gx-track>
      <% (@featured_products.to_a * 2).each_with_index do |product, j| %>
        <% i = j % @featured_products.size; copy = j >= @featured_products.size %>
        <article class="gx-card" <%= 'aria-hidden=true' if copy %> <%= 'inert' if copy %>>
          <div class="gx-card__media">
            <%= link_to shop_product_path(product.product_category.slug, product.slug), class: "gx-card__img", draggable: false do %>
              <% if product.respond_to?(:images) && product.images.attached? && product.images.any? %>
                <%= image_tag product.images.first, alt: product.name, loading: "lazy", draggable: false %>
              <% elsif product.respond_to?(:image) && product.image.attached? %>
                <%= image_tag product.image, alt: product.name, loading: "lazy", draggable: false %>
              <% else %>
                <span class="gx-card__brand-ph"><%= product.brand.presence || product.name %></span>
              <% end %>
            <% end %>
            <span class="gx-card__num"><%= format("%02d", i + 1) %></span>
            <% if product.in_stock? %>
              <%= form_with url: cart_add_item_path, method: :post, data: { turbo_stream: true }, class: "gx-card__cart" do |f| %>
                <%= f.hidden_field :product_id, value: product.id %>
                <%= f.hidden_field :quantity, value: 1 %>
                <%= f.submit "Añadir al carrito" %>
              <% end %>
            <% else %>
              <span class="gx-card__badge">Sin stock</span>
            <% end %>
          </div>
          <div class="gx-card__info">
            <div>
              <p class="gx-card__brand"><%= product.brand %></p>
              <h3 class="gx-card__name"><%= link_to product.name, shop_product_path(product.product_category.slug, product.slug) %></h3>
            </div>
            <p class="gx-card__price"><%= number_to_currency(product.price_cents, unit: "$", separator: ",", delimiter: ".", precision: 0) %></p>
          </div>
        </article>
      <% end %>
    </div>
  </div>

  <div class="gx-prod__foot">
    <p class="gx-prod__hint">Mouse a un lado para girar · al centro para detener</p>
    <div class="gx-prod__progress"><span data-gx-progress></span></div>
    <%= link_to shop_path, class: "gx-all" do %>Ver tienda completa <span>→</span><% end %>
  </div>
</section>

<style>
  .gx-prod{background:#FAFAF8;padding:5.5rem 0;overflow:hidden}
  .gx-prod__head,.gx-prod__foot{max-width:72rem;margin:auto;padding:0 1.5rem;display:flex;align-items:flex-end;justify-content:space-between;gap:1rem}
  .gx-prod__head{margin-bottom:2.5rem}
.gx-prod__viewport{overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);touch-action:pan-y}
.gx-prod__track{display:flex;gap:1.5rem;width:max-content;padding:0 1.5rem;user-select:none;will-change:transform}
.gx-card{flex:none;width:clamp(220px,24vw,300px);transition:transform .6s cubic-bezier(.2,.8,.2,1)}
.gx-card:hover{transform:translateY(-8px)}
  .gx-card__media{position:relative;aspect-ratio:4/5;overflow:hidden;background:#EFE4DA}
  .gx-card__img{display:block;width:100%;height:100%}
  .gx-card__img img{width:100%;height:100%;object-fit:cover;transform:scale(1.04);transition:transform 1.2s cubic-bezier(.2,.8,.2,1)}
  .gx-card:hover .gx-card__img img{transform:scale(1.1)}
  .gx-card__brand-ph{display:flex;align-items:center;justify-content:center;height:100%;padding:1rem;text-align:center;font-family:'Noto Serif',serif;font-style:italic;font-size:1.6rem;color:#8A7A68;background:linear-gradient(160deg,#F1E3D6,#E2CDBB)}
  .gx-card__num{position:absolute;top:1rem;left:1.1rem;font-family:'Noto Serif',serif;font-style:italic;font-size:1.6rem;color:rgba(255,255,255,.75);mix-blend-mode:difference;pointer-events:none}
  .gx-card__badge{position:absolute;top:1rem;right:1rem;background:#17120E;color:#fff;font-size:9px;letter-spacing:.25em;text-transform:uppercase;padding:.35rem .6rem}
  .gx-card__cart{position:absolute;left:1rem;right:1rem;bottom:1rem;transform:translateY(140%);transition:transform .5s cubic-bezier(.2,.8,.2,1)}
  .gx-card:hover .gx-card__cart,.gx-card:focus-within .gx-card__cart{transform:none}
  .gx-card__cart input[type=submit]{width:100%;padding:.85rem;background:rgba(255,255,255,.92);border:0;font-family:'Inter',sans-serif;font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:#1A1A1A;cursor:pointer;transition:background .3s,color .3s}
  .gx-card__cart input[type=submit]:hover{background:#17120E;color:#fff}
  .gx-card__info{display:flex;justify-content:space-between;gap:1rem;padding-top:1rem}
  .gx-card__brand{font-size:9px;letter-spacing:.3em;text-transform:uppercase;color:#C9A96E}
  .gx-card__name{font-family:'Noto Serif',serif;font-size:1.1rem;margin-top:.3rem;color:#1A1A1A}
  .gx-card__price{font-family:'Inter',sans-serif;font-weight:500;font-size:.9rem;white-space:nowrap}
  .gx-prod__foot{margin-top:2.5rem;align-items:center}
.gx-prod__hint{font-family:'Inter',sans-serif;font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:#8A7A68}
.gx-prod__progress{flex:1;max-width:18rem;height:2px;background:#DDD2C4;overflow:hidden}
.gx-prod__progress span{display:block;height:100%;width:100%;background:#17120E;transform-origin:left;transform:scaleX(0)}
  .gx-prod .gx-all{margin-top:0}
  @media (max-width:640px){
    .gx-card{width:78vw}
    .gx-card__cart{transform:none}
    .gx-prod__foot{flex-wrap:wrap}
    .gx-prod__hint{display:none}
    .gx-prod__progress{order:3;max-width:none;flex-basis:100%}
  }
</style>

<script>
// Carrusel infinito: gira solo, se detiene sobre un producto y la
// dirección/velocidad sigue al mouse (derecha → avanza, izquierda → retrocede).
(() => {
  const root = document.querySelector("[data-gx-carousel]");
  if (!root) return;
  const vp    = root.querySelector("[data-gx-viewport]");
  const track = root.querySelector("[data-gx-track]");
  const bar   = root.querySelector("[data-gx-progress]");
  const BASE = 40, MAX = 420;          // px/s
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let half = 0, x = 0, v = reduce ? 0 : BASE, target = v, last = 0, raf = 0;
  let onCard = false, drag = null, moved = 0, visible = true;

  const measure = () => { half = track.scrollWidth / 2; };
  const wrap = () => { if (half) { x = ((x % half) + half) % half; } };

  function frame(t) {
    const dt = Math.min((t - (last || t)) / 1000, 0.05); last = t;
    const goal = onCard || drag ? 0 : target;
    v += (goal - v) * Math.min(1, dt * 4);
    if (!drag) x += v * dt;
    wrap();
    track.style.transform = `translate3d(${-x}px,0,0)`;
    if (bar && half) bar.style.transform = `scaleX(${x / half})`;
    raf = visible ? requestAnimationFrame(frame) : 0;
  }

  vp.addEventListener("pointermove", e => {
    if (e.pointerType !== "mouse" || drag) return;
    const r = vp.getBoundingClientRect();
    const rel = ((e.clientX - r.left) / r.width - 0.5) * 2;   // -1 … 1
    // Zona central: sobre un producto se detiene para mirarlo.
    // Hacia los bordes acelera en esa dirección.
    const edge = Math.max(0, (Math.abs(rel) - 0.4) / 0.6);
    onCard = edge === 0 && !!e.target.closest(".gx-card");
    target = edge === 0 ? Math.sign(target || 1) * BASE : Math.sign(rel) * (BASE + edge * (MAX - BASE));
  });
  vp.addEventListener("pointerleave", () => { onCard = false; target = Math.sign(target || 1) * BASE; });

  // Arrastre táctil / con el mouse
  vp.addEventListener("pointerdown", e => {
    if (e.target.closest("form")) return;
    drag = { x: e.clientX, start: x }; moved = 0;
  });
  addEventListener("pointermove", e => {
    if (!drag) return;
    moved = e.clientX - drag.x;
    x = drag.start - moved; wrap();
  });
  addEventListener("pointerup", () => { if (drag) { drag = null; onCard = false; } });
  vp.addEventListener("click", e => { if (Math.abs(moved) > 8) { e.preventDefault(); e.stopPropagation(); moved = 0; } }, true);
  vp.addEventListener("dragstart", e => e.preventDefault());

  // Pausa cuando no está en pantalla
  new IntersectionObserver(([en]) => {
    visible = en.isIntersecting;
    if (visible && !raf) { last = 0; raf = requestAnimationFrame(frame); }
  }).observe(root);

  addEventListener("resize", measure);
  addEventListener("load", measure);
  measure(); raf = requestAnimationFrame(frame);
  document.addEventListener("turbo:before-render", () => { cancelAnimationFrame(raf); visible = false; }, { once: true });
})();

  // Parallax de la foto pequeña de "Sobre nosotras"
  (() => {
    const els = document.querySelectorAll("[data-gx-speed]");
    if (!els.length || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const run = () => els.forEach(el => {
      const r = el.parentElement.getBoundingClientRect();
      el.style.transform = `translateY(${(r.top + r.height / 2 - innerHeight / 2) * -el.dataset.gxSpeed}px)`;
    });
    addEventListener("scroll", run, { passive: true }); run();
  })();
</script>
<% end %>

<!-- ═══════════════════════════════════════════════
     NUESTRAS ESTILISTAS
════════════════════════════════════════════════ -->
<section class="gx-team">
  <div class="gx-team__head">
    <p class="font-label-caps text-[11px] tracking-[0.25em] uppercase mb-4" style="color:#C9A96E;">El equipo</p>
    <h2 class="gx-h2">Manos que <em>transforman</em></h2>
  </div>

  <div class="gx-team__grid">
    <% @stylists.each_with_index do |stylist, i| %>
      <%= link_to new_appointment_path, class: "gx-member gx-reveal", style: "transition-delay:#{(i % 4) * 0.12}s" do %>
        <div class="gx-arch">
          <% if stylist.avatar.attached? %>
            <%= image_tag url_for(stylist.avatar), class: "gx-arch__ph", alt: stylist.full_name, loading: "lazy" %>
          <% elsif stylist.avatar_url.present? %>
            <%= image_tag stylist.avatar_url, class: "gx-arch__ph", alt: stylist.full_name, loading: "lazy" %>
          <% else %>
            <div class="gx-arch__ph gx-arch__ph--initial"><%= stylist.first_name[0] %></div>
          <% end %>
        </div>
        <h3 class="gx-member__name"><%= stylist.full_name %></h3>
        <p class="gx-member__role">Estilista</p>
      <% end %>
    <% end %>
  </div>
</section>

<style>
  .gx-h2{font-family:'Noto Serif',serif;font-weight:400;font-size:clamp(2rem,4.5vw,3rem);line-height:1.15}
  .gx-h2 em{font-style:italic;color:#C9A96E}
  .gx-reveal{opacity:0;transform:translateY(60px);transition:opacity 1s ease,transform 1.2s cubic-bezier(.2,.8,.2,1)}
  .gx-reveal.is-in{opacity:1;transform:none}

  /* Equipo */
  .gx-team{background:#17120E;color:#F4EEE6;padding:7rem 1rem 8rem;overflow:hidden}
  .gx-team__head{text-align:center;margin-bottom:4rem}
  .gx-team__grid{max-width:72rem;margin:auto;display:grid;gap:2.5rem 2rem;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),250px));justify-content:center}
  .gx-member{display:block;text-align:center;color:inherit;text-decoration:none}
  .gx-arch{position:relative;aspect-ratio:3/4;border-radius:999px 999px 6px 6px;overflow:hidden;background:#2A221B}
  .gx-arch__ph{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(1.05);transform:scale(1.12);transition:filter .9s ease,transform 1.4s cubic-bezier(.2,.8,.2,1)}
  .gx-arch__ph--initial{display:flex;align-items:center;justify-content:center;font-family:'Noto Serif',serif;font-size:4rem;background:linear-gradient(160deg,#C9A96E,#5A3E2C)}
  .gx-member.is-in .gx-arch__ph{transform:scale(1)}
  .gx-member:hover .gx-arch__ph,.gx-member:focus-visible .gx-arch__ph{filter:grayscale(0);transform:scale(1.05)}
  .gx-arch::after{content:"";position:absolute;inset:10px;border:1px solid transparent;border-radius:inherit;transition:border-color .6s;pointer-events:none}
  .gx-member:hover .gx-arch::after{border-color:rgba(201,169,110,.75)}
  .gx-member__name{font-family:'Noto Serif',serif;font-size:1.5rem;margin-top:1.4rem}
  .gx-member__role{font-size:10px;letter-spacing:.35em;text-transform:uppercase;color:#C9A96E;margin-top:.4rem}
  @media (max-width:640px){
    .gx-team__grid{grid-template-columns:minmax(0,320px)}
    .gx-member.is-in .gx-arch__ph{filter:grayscale(0)} /* sin cursor: a color al aparecer */
  }

  /* Servicios */
  .gx-services{padding:5rem 1.5rem}
  .gx-services__inner{max-width:72rem;margin:auto;display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:4rem;align-items:start}
  .gx-services__aside{position:sticky;top:7rem}
  .gx-services__lead{margin-top:1.2rem;max-width:22rem;font-family:'Inter',sans-serif;font-size:.95rem;line-height:1.7;color:#6B5D50}
  .gx-services__photo{margin-top:2rem;aspect-ratio:4/3;overflow:hidden;border-radius:999px 999px 0 0;background:#EFE4DA;max-width:22rem}
  .gx-services__photo img{width:100%;height:100%;object-fit:cover;transition:transform 1.2s cubic-bezier(.2,.8,.2,1)}
  .gx-services__photo:hover img{transform:scale(1.05)}
  .gx-services__list{border-bottom:1px solid #DDD2C4}
  @media (max-width:900px){.gx-services__inner{grid-template-columns:1fr;gap:2rem}.gx-services__aside{position:static}.gx-services__photo{display:none}}
  .gx-row{position:relative;display:flex;align-items:center;gap:1.4rem;padding:1.35rem 1.1rem;border-top:1px solid #DDD2C4;color:#1A1A1A;text-decoration:none;overflow:hidden;transform:translateX(-40px)}
  .gx-row::before{content:"";position:absolute;inset:0;background:#FFFAF3;transform:scaleX(0);transform-origin:left;transition:transform .55s cubic-bezier(.7,0,.2,1)}
  .gx-row::after{content:"";position:absolute;left:0;top:0;bottom:0;width:2px;background:#C9A96E;transform:scaleY(0);transition:transform .45s .1s}
  .gx-row:hover::before,.gx-row:focus-visible::before{transform:scaleX(1)}
  .gx-row:hover::after,.gx-row:focus-visible::after{transform:scaleY(1)}
  .gx-row>*{position:relative}
  .gx-row__num{font-size:11px;color:#8A7A68;width:1.5rem}
  .gx-row__title{flex:1;font-family:'Noto Serif',serif;font-size:clamp(1.3rem,3vw,1.9rem);transition:transform .5s cubic-bezier(.2,.8,.2,1)}
  .gx-row:hover .gx-row__title,.gx-row:focus-visible .gx-row__title{font-style:italic;transform:translateX(14px)}
  .gx-row__meta{text-align:right;font-family:'Inter',sans-serif}
  .gx-row__meta small{display:block;font-size:10px;letter-spacing:.3em;color:#8A7A68}
  .gx-row__meta b{font-weight:500;font-size:.9rem}
  .gx-row__arrow{width:0;opacity:0;color:#C9A96E;transition:width .4s,opacity .4s}
  .gx-row:hover .gx-row__arrow{width:1.4rem;opacity:1}
  .gx-all{display:inline-block;margin-top:2rem;font-size:11px;letter-spacing:.3em;text-transform:uppercase;color:#1A1A1A;border-bottom:1px solid currentColor;padding-bottom:4px}
  .gx-all span{display:inline-block;transition:transform .3s}.gx-all:hover span{transform:translateX(6px)}
  @media (max-width:640px){.gx-row{padding:1.4rem .5rem;gap:.8rem}}
  @media (prefers-reduced-motion:reduce){.gx-reveal,.gx-row{opacity:1!important;transform:none!important;transition:none!important}}
</style>
<script>
  (() => {
    const els = document.querySelectorAll(".gx-reveal:not(.is-in)");
    if (!("IntersectionObserver" in window)) { els.forEach(e => e.classList.add("is-in")); return; }
    const io = new IntersectionObserver(entries => entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); }
    }), { threshold: 0.15 });
    els.forEach(e => io.observe(e));
  })();
</script>

