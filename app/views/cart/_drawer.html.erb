<%# Cart drawer — data-controller lives on <body> in application.html.erb %>
<%# Data is fetched via /carrito/datos (JSON) when the drawer opens %>

<!-- Backdrop -->
<div data-cart-drawer-target="backdrop"
     data-action="click->cart-drawer#close"
     class="fixed inset-0 bg-black/40 z-40 hidden opacity-0 transition-opacity duration-300 backdrop-blur-sm"></div>

<!-- Panel -->
<aside data-cart-drawer-target="panel"
       class="sx-drawer fixed top-0 right-0 h-full w-full max-w-md z-50
              translate-x-full transition-transform duration-500 ease-in-out
              flex flex-col shadow-2xl">

  <!-- Header -->
  <div class="relative px-8 pt-10 pb-6 text-center">
    <h2 class="sx-drawer__title">Tu bolsa</h2>
    <p class="sx-drawer__label mt-2" style="color:#8A7A68;font-size:10px;">
      <span data-cart-drawer-target="count">0</span> producto(s)
    </p>
    <button type="button" data-action="click->cart-drawer#close"
            class="sx-drawer__close absolute top-6 right-6" aria-label="Cerrar">
      <span class="material-symbols-outlined text-[20px]" style="color:#5C4B39;">close</span>
    </button>
  </div>

  <!-- Vacío -->
  <div data-cart-drawer-target="emptyState"
       class="flex-1 flex flex-col items-center justify-center gap-4 px-8 text-center">
    <p class="sx-drawer__title" style="font-size:1.8rem;">Tu bolsa está vacía</p>
    <p class="text-sm" style="color:#8A7A68;">Descubre lo que usamos en el salón.</p>
    <%= link_to "Ir a la tienda", shop_path, class: "sx-btn mt-4", style: "max-width:16rem;",
          data: { action: "click->cart-drawer#close", turbo_frame: "_top" } %>
  </div>

  <!-- Productos -->
  <div data-cart-drawer-target="items" class="hidden flex-1 overflow-y-auto px-8"></div>

  <!-- Footer -->
  <div data-cart-drawer-target="footer" class="hidden px-8 pt-6 pb-8 space-y-5" style="border-top:1px solid #E4DCD1;">
    <div class="flex items-baseline justify-between">
      <span class="sx-drawer__label">Subtotal</span>
      <span class="sx-drawer__total" data-cart-drawer-target="subtotal">—</span>
    </div>
    <div>
      <%= link_to "Ir a pagar", checkout_path, class: "sx-btn", style: "padding:1.2rem;",
            data: { turbo_frame: "_top" } %>
      <%= link_to "Ver bolsa completa", cart_path, class: "sx-drawer__link mt-2",
            data: { action: "click->cart-drawer#close", turbo_frame: "_top" } %>
    </div>
  </div>

</aside>
