<!DOCTYPE html>
<html lang="es">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Studio Graffé</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background-color: #f8f6f5; font-family: Arial, sans-serif; color: #1c1a19; -webkit-text-size-adjust: 100%; }
    .email-wrapper   { background-color: #f8f6f5; padding: 40px 16px; }
    .email-container { max-width: 560px; margin: 0 auto; background-color: #ffffff; border-radius: 16px; overflow: hidden; }
    .email-header    { background-color: #1c1a19; padding: 32px 40px; text-align: center; }
    .email-header h1 { color: #f5f0eb; font-size: 20px; font-weight: 400; letter-spacing: 5px; text-transform: uppercase; }
    .email-header p  { color: #9e9087; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; margin-top: 6px; }
    .email-hero      { background-color: #f5f0eb; padding: 26px 40px; text-align: center; border-bottom: 1px solid #ede8e3; }
    .email-hero .icon{ font-size: 34px; display: block; margin-bottom: 10px; }
    .email-hero h2   { font-size: 18px; font-weight: 700; color: #1c1a19; }
    .email-hero p    { font-size: 13px; color: #6b6360; margin-top: 5px; }
    .email-body      { padding: 30px 40px; }
    .section-label   { font-size: 10px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #9e9087; margin-bottom: 10px; }
    .info-card       { background-color: #f8f6f5; border-radius: 10px; padding: 16px 18px; margin-bottom: 18px; border: 1px solid #ede8e3; }
    .info-row        { display: flex; justify-content: space-between; margin-bottom: 7px; font-size: 13px; }
    .info-row:last-child { margin-bottom: 0; }
    .info-label      { color: #9e9087; }
    .info-value      { color: #1c1a19; font-weight: 600; text-align: right; }
    .products-table  { width: 100%; border-collapse: collapse; margin-bottom: 18px; }
    .products-table th { font-size: 10px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #9e9087; padding: 8px 0; border-bottom: 1px solid #ede8e3; text-align: left; }
    .products-table th:last-child { text-align: right; }
    .products-table td { padding: 12px 0; border-bottom: 1px solid #f0ece8; font-size: 13px; vertical-align: top; }
    .products-table td:last-child { text-align: right; font-weight: 600; }
    .product-name    { font-weight: 600; color: #1c1a19; display: block; }
    .product-qty     { color: #9e9087; font-size: 12px; margin-top: 2px; display: block; }
    .totals-row      { display: flex; justify-content: space-between; padding: 7px 0; font-size: 13px; color: #6b6360; }
    .totals-row.total{ border-top: 2px solid #1c1a19; margin-top: 8px; padding-top: 13px; font-size: 16px; font-weight: 700; color: #1c1a19; }
    .divider         { border: none; border-top: 1px solid #ede8e3; margin: 22px 0; }
    .cta-wrap        { text-align: center; margin: 26px 0 6px; }
    .cta-btn         { display: inline-block; background-color: #1c1a19; color: #ffffff !important; text-decoration: none; padding: 13px 34px; border-radius: 999px; font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
    .email-footer    { background-color: #f8f6f5; padding: 22px 40px; text-align: center; border-top: 1px solid #ede8e3; }
    .email-footer p  { font-size: 11px; color: #b5aaa5; line-height: 1.6; }
    .email-footer a  { color: #9e9087; text-decoration: none; }
  </style>
</head>
<body>
  <div class="email-wrapper">
    <div class="email-container">
      <%= yield %>
    </div>
    <p style="text-align:center;font-size:11px;color:#b5aaa5;margin-top:18px;">
      Studio Graffé · Santiago, Chile ·
      <a href="https://studiograffe.cl" style="color:#9e9087;">studiograffe.cl</a>
    </p>
  </div>
</body>
</html>
