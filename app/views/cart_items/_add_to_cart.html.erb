<%= turbo_frame_tag "cart-product-#{product.id}" do %>
  <% if !user_signed_in? %>
    <%# Sin sesión: salir del frame e ir al ingreso (evita "Content missing") %>
    <%= link_to "Añadir", new_user_session_path, class: "sx-btn", data: { turbo_frame: "_top" } %>
  <% elsif cart_item&.persisted? %>
    <% at_max_stock = cart_item.quantity >= product.stock_quantity %>
    <div class="sx-qty">
      <%= button_to "−", update_cart_item_path(cart_item), method: :patch,
            params: { quantity: [ cart_item.quantity - 1, 0 ].max },
            form: { data: { turbo_stream: true } }, aria: { label: "Quitar uno" } %>
      <span>
        <%= cart_item.quantity %>
        <% if at_max_stock %><small>máx</small><% end %>
      </span>
      <%= button_to "+", update_cart_item_path(cart_item), method: :patch,
            params: { quantity: cart_item.quantity + 1 },
            form: { data: { turbo_stream: true } }, disabled: at_max_stock, aria: { label: "Agregar uno" } %>
    </div>
  <% else %>
    <%= form_with url: cart_add_item_path, method: :post, data: { turbo_stream: true } do |f| %>
      <%= f.hidden_field :product_id, value: product.id %>
      <%= f.hidden_field :quantity, value: 1 %>
      <%= f.submit "Añadir", class: "sx-btn" %>
    <% end %>
  <% end %>
<% end %>
