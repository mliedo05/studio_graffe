<aside class="hidden md:flex flex-col py-8 px-4 h-screen sticky top-20 w-64 border-r border-stone-200 dark:border-stone-800 bg-stone-50 dark:bg-stone-950 overflow-y-auto">
  <!-- Categorías -->
  <div class="mb-4 px-4">
    <h2 class="text-lg font-bold text-black dark:text-white font-serif mb-1">Categorías</h2>
    <p class="text-[10px] uppercase tracking-widest text-stone-400">Filtrar productos</p>
  </div>
  <nav class="space-y-1 mb-8">
    <%= link_to shop_path,
          class: "flex items-center gap-3 py-3 px-4 transition-all duration-200 ease-in-out font-serif text-sm uppercase tracking-widest #{!current_category && !current_brand ? 'text-amber-600 dark:text-amber-400 font-bold bg-amber-50/50 dark:bg-amber-950/20' : 'text-stone-500 dark:text-stone-400 hover:bg-stone-100 dark:hover:bg-stone-900'}" do %>
      <span class="material-symbols-outlined text-lg">category</span>
      Todos
    <% end %>
    <% (local_assigns[:categories] || @categories || []).each do |category| %>
      <%= link_to shop_category_path(category.slug),
            class: "flex items-center gap-3 py-3 px-4 transition-all duration-200 ease-in-out font-serif text-sm uppercase tracking-widest #{current_category == category.slug ? 'text-amber-600 dark:text-amber-400 font-bold bg-amber-50/50 dark:bg-amber-950/20' : 'text-stone-500 dark:text-stone-400 hover:bg-stone-100 dark:hover:bg-stone-900'}" do %>
        <span class="material-symbols-outlined text-lg">label</span>
        <%= category.name %>
      <% end %>
    <% end %>
  </nav>

  <!-- Marcas -->
  <div class="mb-4 px-4 border-t border-stone-200 dark:border-stone-800 pt-6">
    <h2 class="text-lg font-bold text-black dark:text-white font-serif mb-1">Marcas</h2>
    <p class="text-[10px] uppercase tracking-widest text-stone-400">Filtrar por marca</p>
  </div>
  <nav class="space-y-1">
    <% (local_assigns[:brands] || @brands || []).each do |brand| %>
      <% slug = ShopService.brand_slug(brand) %>
      <%= link_to shop_brand_path(slug),
            class: "flex items-center gap-3 py-3 px-4 transition-all duration-200 ease-in-out font-serif text-sm uppercase tracking-widest #{current_brand == brand ? 'text-amber-600 dark:text-amber-400 font-bold bg-amber-50/50 dark:bg-amber-950/20' : 'text-stone-500 dark:text-stone-400 hover:bg-stone-100 dark:hover:bg-stone-900'}" do %>
        <span class="material-symbols-outlined text-lg">storefront</span>
        <%= brand %>
      <% end %>
    <% end %>
  </nav>
</aside>
